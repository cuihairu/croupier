{
  "name": "croupier",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "install": "pnpm install --ignore-scripts",
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier && npm run tsc",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c \"src/**/*.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "openapi": "max openapi",
    "prepare": "node scripts/prepare.js",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --project=real-dashboard",
    "test:e2e:ui": "playwright test --ui",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.2.3",
    "@ant-design/pro-components": "^3.1.12-0",
    "@ant-design/x": "^2.7.0",
    "@ant-design/x-markdown": "^2.7.0",
    "@ant-design/x-sdk": "^2.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/antd": "^6.7.1",
    "@rjsf/core": "^6.7.1",
    "@rjsf/utils": "^6.7.1",
    "@rjsf/validator-ajv8": "^6.7.1",
    "@umijs/route-utils": "^2.2.2",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.54.0",
    "omit.js": "^2.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^1.3.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.4.3",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@biomejs/biome": "^2.4.13",
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/history": "^4.7.11",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.202",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@umijs/fabric": "^2.14.1",
    "@umijs/lint": "^4.7.4",
    "@umijs/max": "^4.7.3",
    "baseline-browser-mapping": "^2.9.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.2.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.2",
    "prettier": "^3.9.6",
    "react-dev-inspector": "^2.0.1",
    "serve-handler": "^6.1.7",
    "swagger-ui-dist": "^5.32.5",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "overrides": {
    "@rc-component/resize-observer": "^1.6.0",
    "rc-resize-observer": "npm:@rc-component/resize-observer@^1.6.0",
    "rc-util": "^5.45.0",
    "rc-trigger": "^5.3.6",
    "rc-tooltip": "^6.5.0",
    "rc-overflow": "^1.5.1",
    "rc-menu": "^9.16.3",
    "glob": "^10.5.0",
    "react-router-dom": "^6.30.6",
    "react-router": "^6.30.6",
    "@remix-run/router": "^1.23.4",
    "axios": "^0.30.0",
    "debug": "^2.6.9",
    "marked": "^4.0.10",
    "node-fetch": "^2.6.7",
    "postcss": "^8.4.31",
    "qs": "^6.14.1",
    "vite": "^5.4.20",
    "rollup": "^3.30.0",
    "@tootallnate/once": "^3.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
