          "manifest": {
            "id": "official.notification",
            "name": "notification",
            "displayName": "通知中心",
            "version": "1.0.0",
            "kind": "official",
            "defaultInstall": false,
            "tags": ["official", "notification"],
            "capabilities": ["notifications.management", "notifications.send"],
            "permissions": {
              "read": "notification.read",
              "operate": "notification.operate",
              "admin": "notification.admin"
            },
            "pages": [
              {
                "key": "notifications.overview",
                "title": "通知中心",
                "route": "/extensions/official/notification",
                "icon": "notification",
                "order": 10,
                "requiredPermission": "notification.read"
              }
            ],
            "configSchema": {
              "type": "object",
              "properties": {
                "emailEnabled": {
                  "type": "boolean",
                  "description": "是否启用邮件渠道",
                  "required": false,
                  "default": true
                },
                "webhookUrl": {
                  "type": "string",
                  "description": "Webhook 回调地址",
                  "required": false
                },
                "retryTimes": {
                  "type": "integer",
                  "description": "发送失败重试次数",
                  "required": false,
                  "default": 3
                }
              },
              "required": []
            }
          }
        }
