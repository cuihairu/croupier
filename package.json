{
  "name": "croupier-repo-tools",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "format:check": "prettier -c README.md docs/index.md \"docs/development/**/*.md\" \"docs/sdks/**/*.md\" \".github/workflows/*.yml\"",
    "prepare": "husky",
    "gofmt:check": "gofmt -l .",
    "gofmt:fix": "gofmt -w .",
    "go:vet": "go vet ./..."
  },
  "lint-staged": {
    "*.go": [
      "gofmt -w",
      "bash -c 'go vet ./...'"
    ],
    "*.{md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
