# syntax=docker/dockerfile:1
ARG GO_IMAGE=golang:1.27.3
ARG RUNTIME_IMAGE=gcr.io/distroless/static:nonroot
ARG GOPROXY_URL=https://goproxy.cn,direct
FROM ${GO_IMAGE} AS build
WORKDIR /src
ARG GOPROXY_URL
# 版本注入：CI 或本地构建经 --build-arg 传入，ldflags 写入 cmd/capture-agent 的
# Version/GitCommit/BuildTime（--version 可见）。缺省 dev。
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=
ENV GOPROXY=${GOPROXY_URL} \
    GOFLAGS=-modcacherw
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOFLAGS=-mod=mod \
    go build -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT} -X main.BuildTime=${BUILD_TIME}" \
    -o /out/capture-agent ./cmd/capture-agent
# data/capture 存放心跳打点与位点（bookmark）文件，预建并归属 nonroot
RUN mkdir -p /out/logs /out/data/capture

FROM ${RUNTIME_IMAGE}
WORKDIR /app
# busybox-static 提供最小 shell/find 工具（心跳文件新鲜度 healthcheck 用）；
# 仍保持 distroless 基底，不引入包管理器。
COPY --from=busybox:1.37-uclibc --chown=nonroot:nonroot /bin/busybox /usr/local/bin/busybox
# distroless 的 /bin 不允许 nonroot 写入；把 applet 链接装到 /usr/local/bin
# （该目录在默认 PATH 中，sh/find/grep 等可直接调用）
RUN ["/usr/local/bin/busybox", "--install", "/usr/local/bin"]
COPY --from=build /out/capture-agent /app/
COPY --from=build --chown=nonroot:nonroot /src/configs /app/configs
COPY --from=build --chown=nonroot:nonroot /out/data /app/data
COPY --from=build --chown=nonroot:nonroot /out/logs /app/logs
# capture agent 仅出站连 server:19090，无本地监听端口，故无 EXPOSE
USER nonroot
ENTRYPOINT ["/app/capture-agent"]
