# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.env
# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
cover.html
coverage.html
platform_coverage.html
coverage_refactor
coverage_refactor_latest
coverage_target

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local build and generated code
bin/
gen/

# Generated binaries (files)
protoc-gen-croupier
/http

# Local module/build caches
.gocache/
.gomodcache/

# Local TLS dev certs
configs/dev/
configs/ops_state.json

# Logs
logs/
.tmp/

# IDE
.idea/
.DS_Store
.bufcache
.claude
# 允许团队共享的 VSCode 配置（使用 ${workspaceFolder} 变量）
# .vscode/settings.json  # 已注释，允许提交
.vscode/settings.local.json  # 个人配置放这里
.vscode/.intellisense-cache
node_modules/

# Local binaries (root)
/server
/prom
/croupier
/agent
data/
sdks/cpp/vcpkg_installed/

# Local IP2Location BIN databases (downloaded externally; do not commit)
configs/IP2LOCATION-LITE-DB*.BIN
configs/*.BIN
web.local/
docs_new/

# Dashboard specific
web/node_modules/
web/node_modules/.cache/
web/node_modules/.pnpm-store/
web/.umi/
web/src/.umi/
web/src/.umi-production/
web/dist/
web/build/
web/.next/
web/.cache/
web/.nyc_output/
web/coverage/
web/.eslintcache
web/.DS_Store
web/.pnpm-debug.log
web/yarn.lock
web/pnpm-lock.yaml

# API Documentation and Swagger Files (临时生成的文件)
# 保留主要的 server.api 和必要的文档，忽略临时生成的文件
services/server/croupier-api-simple.json
services/server/croupier-api-*.json
services/server/croupier-api.json
services/server/croupier-apifox-collection.json
services/server/test-swagger.json
services/server/server.json
services/server/simple-swagger.api
services/server/temp-server.api
services/server/backup-*.api
services/server/*.backup.*
services/server/annotated-api.api
services/server/api.api.bak

# Temporary API files and scripts
services/server/missing_handlers.txt
services/server/original_handlers.txt
services/server/current_handlers.txt

# Generated backup files
*.backup.*
*_backup.*

# Temporary build artifacts
services/*/bin/
services/*/logs/
services/*/__debug_bin*
cmd/*/__debug_bin*
__debug_bin.exe*

# Python bytecode caches
sdks/python/croupier/__pycache__/
sdks/python/examples/__pycache__/
sdks/cpp/build/
sdks/cpp/bin/
sdks/cpp/lib/
build/*/proto/
*.crt
*.key
certs/
stdout
internal/api/**/ops_state.json
