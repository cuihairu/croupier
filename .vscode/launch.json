{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (dev sqlite)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "args": [
        "-f",
        "configs/server.yaml"
      ],
      "env": {
        "CROUPIER_DEV_SEED": "1",
        "DB_DRIVER": "sqlite",
        "DATABASE_URL": "data/croupier.db"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server (postgres)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "args": [
        "-f",
        "configs/server.yaml"
      ],
      "env": {
        "DB_DRIVER": "postgres",
        "DATABASE_URL": "postgres://croupier:croupier_dev_password@localhost:5432/croupier?sslmode=disable",
        "REDIS_URL": "redis://localhost:6379/0",
        "CLICKHOUSE_DSN": "clickhouse://localhost:9000/analytics"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Server (mysql)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "args": [
        "-f",
        "configs/server.yaml"
      ],
      "env": {
        "DB_DRIVER": "mysql",
        "DATABASE_URL": "croupier:croupier_dev_password@tcp(localhost:3306)/croupier?charset=utf8mb4&parseTime=True&loc=Local",
        "REDIS_URL": "redis://localhost:6379/0",
        "CLICKHOUSE_DSN": "clickhouse://localhost:9000/analytics"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Agent (dev)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/agent",
      "args": [
        "-f",
        "configs/agent.local.yaml"
      ],
      "env": {},
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Agent (多文件示例)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/agent",
      "args": [
        "-f",
        "configs/agent.local.yaml"
      ],
      "env": {
        "PROVIDER_CONFIG": "configs/providers.yaml"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Agent (加载所有 Packs)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/agent",
      "args": [
        "-f",
        "configs/agent.local.yaml"
      ],
      "env": {
        "GAME_ID": "dev-game",
        "ENV": "dev"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Agent (调试模式)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/agent",
      "args": [
        "-f",
        "configs/agent.local.yaml",
        "-log.level",
        "debug"
      ],
      "env": {
        "CROUPIER_DEV": "1"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "showLog": true
    },
    {
      "name": "Agent (微服务架构)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/agent",
      "args": [
        "-f",
        "configs/agent.local.yaml"
      ],
      "env": {
        "PLAYER_SERVICE_TOKEN": "dev-token-player",
        "INVENTORY_SERVICE_TOKEN": "dev-token-inventory",
        "CHAT_SERVICE_TOKEN": "dev-token-chat",
        "MATCH_SERVICE_TOKEN": "dev-token-match"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Analytics Worker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/analytics-worker",
      "env": {
        "REDIS_URL": "redis://localhost:6379/0",
        "CLICKHOUSE_DSN": "clickhouse://localhost:9000/analytics"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
