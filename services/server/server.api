syntax = "v1"

info (
	title:   "Croupier API"
	desc:    "Croupier 游戏管理平台 API"
	author:  "cuihairu"
	email:   "chuihairu@gmail.com"
	version: "v0.1.0"
)

// ============================================================================
// 导入所有模块
// ============================================================================
// === 核心业务模块 ===
import "modules/auth.api"
import "modules/admin.api" // 替代原 user.api 的管理员部分
import "modules/player.api" // 替代原 user.api 的玩家部分
import "modules/profile.api" // 替代原 user.api 的个人资料部分
// import "modules/permission.api"     // 权限管理已合并到 admin.api
import "modules/game.api"
import "modules/entity.api"
// === 函数管理模块 ===
import "modules/function.api" // 合并了 function + permission + ui
import "modules/routes.api" // 动态路由配置
// === 运行时模块 ===
import "modules/job.api"
import "modules/agent.api"
import "modules/provider.api"
import "modules/component.api"
// === 配置管理模块 ===
import "modules/config.api"
import "modules/schema.api"
import "modules/assignment.api"
import "modules/pack.api"
// === 数据分析模块 ===
import "modules/analytics_overview.api" // 拆分自 analytics.api
import "modules/analytics_behavior.api" // 拆分自 analytics.api
import "modules/analytics_retention.api" // 拆分自 analytics.api
import "modules/analytics_payments.api" // 拆分自 analytics.api
// === 运维管理模块 ===
import "modules/ops.api" // 拆分自原 ops.api 的核心部分
import "modules/backup.api" // 拆分自原 ops.api
import "modules/node.api" // 拆分自原 ops.api
import "modules/alert.api" // 拆分自原 ops.api
import "modules/rate_limit.api" // 拆分自原 ops.api
// === 客户支持模块 ===
import "modules/ticket.api" // 拆分自 support.api
import "modules/faq.api" // 拆分自 support.api
import "modules/feedback.api" // 拆分自 support.api
// === 系统级模块 ===
import "modules/monitoring.api"
import "modules/audit.api"
import "modules/registry.api"
import "modules/message.api"
import "modules/approval.api"
import "modules/certificate.api"
import "modules/storage.api"
// === UI 相关模块 ===
import "modules/xrender.api"
import "modules/meta.api"
// === 第三方平台集成模块 ===
import "modules/platform.api"
