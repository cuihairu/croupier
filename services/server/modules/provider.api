// ============================================================================
// PROVIDER 模块 API 定义 - 提供者管理
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- Provider 能力 ---
type ProvidersCapabilitiesRequest {}

type ProvidersCapabilitiesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 操作 ---
type ProviderActionRequest {
	ID string `path:"id"`
}

type ProviderDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 描述符 ---
type ProvidersDescriptorsRequest {}

type ProvidersDescriptorsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 详情 ---
type ProviderDetailRequest {
	ID string `path:"id"`
}

type ProviderDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 实体 ---
type ProvidersEntitiesRequest {
	ID string `path:"id"`
}

type ProvidersEntitiesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 列表 ---
type ProvidersListRequest {
	Page     int `form:"page,optional"`
	PageSize int `form:"pageSize,optional"`
}

type ProvidersListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Provider 重载 ---
type ProviderReloadResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/providers
	group:  provider
)
service server {
	@doc "获取提供者列表"
	@handler ProvidersListHandler
	get / (ProvidersListRequest) returns (ProvidersListResponse)

	@doc "获取提供者能力"
	@handler ProvidersCapabilitiesHandler
	get /capabilities (ProvidersCapabilitiesRequest) returns (ProvidersCapabilitiesResponse)

	@doc "获取提供者描述符"
	@handler ProvidersDescriptorsHandler
	get /descriptors (ProvidersDescriptorsRequest) returns (ProvidersDescriptorsResponse)

	@doc "获取提供者详情"
	@handler ProvidersDetailHandler
	get /:id (ProviderDetailRequest) returns (ProviderDetailResponse)

	@doc "获取提供者实体"
	@handler ProvidersEntitiesHandler
	get /:id/entities (ProvidersEntitiesRequest) returns (ProvidersEntitiesResponse)

	@doc "删除提供者"
	@handler ProvidersDeleteHandler
	delete /:id (ProviderActionRequest) returns (ProviderDeleteResponse)

	@doc "重新加载提供者"
	@handler ProvidersReloadHandler
	post /:id/reload (ProviderActionRequest) returns (ProviderReloadResponse)
}

