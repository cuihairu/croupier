// ============================================================================
// BACKUP 模块 API 定义 - 备份管理
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================
type Backup {
	Id        string `json:"id"`
	Name      string `json:"name"`
	Size      int64  `json:"size"`
	Type      string `json:"type"`
	Status    string `json:"status"`
	CreatedAt string `json:"createdAt"`
}

// --- 备份列表 ---
type BackupsListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Type     string `form:"type,optional"`
}

type BackupsListResponse {
	Items []Backup `json:"items"`
	Total int64    `json:"total"`
	Page  int      `json:"page"`
	Size  int      `json:"pageSize"`
}

// --- 创建备份 ---
type BackupCreateRequest {
	Name string `json:"name,optional"`
	Type string `json:"type,optional"` // full, incremental
}

type BackupDetailResponse {
	Backup
}

// --- 删除备份 ---
type BackupDeleteRequest {
	ID string `path:"id"`
}

// --- 下载备份 ---
type BackupDownloadRequest {
	ID string `path:"id"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/backups
	group:  backup
)
service server {
	@doc "获取备份列表"
	@handler BackupsListHandler
	get / (BackupsListRequest) returns (BackupsListResponse)

	@doc "创建备份"
	@handler BackupCreateHandler
	post / (BackupCreateRequest) returns (BackupDetailResponse)

	@doc "删除备份"
	@handler BackupDeleteHandler
	delete /:id (BackupDeleteRequest)

	@doc "下载备份"
	@handler BackupDownloadHandler
	get /:id/download (BackupDownloadRequest)
}
