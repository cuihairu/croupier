// ============================================================================
// TICKET 模块 API 定义 - 工单系统
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================
type Ticket {
	Id        int64    `json:"id"`
	Title     string   `json:"title"`
	Content   string   `json:"content"`
	Category  string   `json:"category"`
	Priority  string   `json:"priority"`
	Status    string   `json:"status"`
	Assignee  string   `json:"assignee"`
	Tags      []string `json:"tags"`
	PlayerId  string   `json:"playerId"`
	Contact   string   `json:"contact"`
	GameId    string   `json:"gameId"`
	Env       string   `json:"env"`
	Source    string   `json:"source"`
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

// --- 工单列表 ---
type TicketsListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Status   string `form:"status,optional"`
	Category string `form:"category,optional"`
	Priority string `form:"priority,optional"`
	Assignee string `form:"assignee,optional"`
}

type TicketsListResponse {
	Items []Ticket `json:"items"`
	Total int64    `json:"total"`
	Page  int      `json:"page"`
	Size  int      `json:"pageSize"`
}

// --- 创建工单 ---
type TicketCreateRequest {
	Title    string   `json:"title"`
	Content  string   `json:"content"`
	Category string   `json:"category"`
	Priority string   `json:"priority,optional,default=medium"`
	Tags     []string `json:"tags,optional"`
	PlayerId string   `json:"playerId,optional"`
	Contact  string   `json:"contact,optional"`
	GameId   string   `json:"gameId,optional"`
	Env      string   `json:"env,optional"`
}

type TicketDetailResponse {
	Ticket
	Comments []Comment `json:"comments,omitempty"`
}

type Comment {
	Id        int64  `json:"id"`
	Content   string `json:"content"`
	Author    string `json:"author"`
	CreatedAt string `json:"createdAt"`
}

// --- 工单详情 ---
type TicketDetailRequest {
	ID string `path:"id"`
}

// --- 更新工单 ---
type TicketUpdateRequest {
	ID       string   `path:"id"`
	Title    string   `json:"title,optional"`
	Content  string   `json:"content,optional"`
	Category string   `json:"category,optional"`
	Priority string   `json:"priority,optional"`
	Assignee string   `json:"assignee,optional"`
	Tags     []string `json:"tags,optional"`
}

// --- 删除工单 ---
type TicketDeleteRequest {
	ID string `path:"id"`
}

// --- 工单状态转换 ---
type TicketTransitionRequest {
	ID     string `path:"id"`
	Status string `json:"status"` // open, in_progress, resolved, closed
	Note   string `json:"note,optional"`
}

// --- 工单评论 ---
type TicketCommentsRequest {
	TicketID string `path:"ticketId"`
}

type TicketCommentsResponse {
	Items []Comment `json:"items"`
}

type TicketCommentCreateRequest {
	TicketID string `path:"ticketId"`
	Content  string `json:"content"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/tickets
	group:  ticket
)
service server {
	@doc "获取工单列表"
	@handler TicketsListHandler
	get / (TicketsListRequest) returns (TicketsListResponse)

	@doc "创建工单"
	@handler TicketCreateHandler
	post / (TicketCreateRequest) returns (TicketDetailResponse)

	@doc "获取工单详情"
	@handler TicketDetailHandler
	get /:id (TicketDetailRequest) returns (TicketDetailResponse)

	@doc "更新工单"
	@handler TicketUpdateHandler
	put /:id (TicketUpdateRequest) returns (TicketDetailResponse)

	@doc "删除工单"
	@handler TicketDeleteHandler
	delete /:id (TicketDeleteRequest)

	@doc "工单状态转换"
	@handler TicketTransitionHandler
	post /:id/transition (TicketTransitionRequest) returns (TicketDetailResponse)

	@doc "获取工单评论"
	@handler TicketCommentsHandler
	get /:ticketId/comments (TicketCommentsRequest) returns (TicketCommentsResponse)

	@doc "创建工单评论"
	@handler TicketCommentCreateHandler
	post /:ticketId/comments (TicketCommentCreateRequest) returns (TicketCommentsResponse)
}
