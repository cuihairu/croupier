// ============================================================================
// SUPPORT 模块 API 定义 - 工单支持系统
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================

// --- 基础数据类型 ---
type SupportTicket {
	Id        int64    `json:"id"`
	Title     string   `json:"title"`
	Content   string   `json:"content"`
	Category  string   `json:"category"`
	Priority  string   `json:"priority"`
	Status    string   `json:"status"`
	Assignee  string   `json:"assignee"`
	Tags      []string `json:"tags"`
	PlayerId  string   `json:"playerId"`
	Contact   string   `json:"contact"`
	GameId    string   `json:"gameId"`
	Env       string   `json:"env"`
	Source    string   `json:"source"`
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

type SupportFAQ {
	Id        int64    `json:"id"`
	Question  string   `json:"question"`
	Answer    string   `json:"answer"`
	Category  string   `json:"category"`
	Tags      []string `json:"tags"`
	Visible   bool     `json:"visible"`
	Sort      int      `json:"sort"`
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

type SupportFeedback {
	Id        int64    `json:"id"`
	PlayerId  string   `json:"playerId"`
	Contact   string   `json:"contact"`
	Content   string   `json:"content"`
	Category  string   `json:"category"`
	Priority  string   `json:"priority"`
	Status    string   `json:"status"`
	Attach    string   `json:"attach"`
	GameId    string   `json:"gameId"`
	Env       string   `json:"env"`
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

// --- 工单列表 ---
type SupportTicketsListRequest {
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
	Status   string `form:"status,optional"`
}

type SupportTicketsListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单创建 ---
type SupportTicketCreateRequest {
	Subject string `json:"subject"`
	Content string `json:"content"`
}

type SupportTicketCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单详情 ---
type SupportTicketDetailRequest {
	ID string `path:"id"`
}

type SupportTicketDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单更新 ---
type SupportTicketUpdateRequest {
	ID      string `path:"id"`
	Subject string `json:"subject,optional"`
	Content string `json:"content,optional"`
}

type SupportTicketUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单删除 ---
type SupportTicketDeleteRequest {
	ID string `path:"id"`
}

type SupportTicketDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单状态转换 ---
type SupportTicketTransitionRequest {
	ID     string `path:"id"`
	Status string `json:"status"`
}

type SupportTicketTransitionResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单评论列表 ---
type SupportCommentsListRequest {
	TicketID string `path:"ticketId"`
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
}

type SupportCommentsListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 工单评论创建 ---
type SupportCommentCreateRequest {
	TicketID string `path:"ticketId"`
	Content  string `json:"content"`
}

type SupportCommentCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- FAQ 列表 ---
type SupportFAQListRequest {
	Category string `form:"category,optional"`
}

type SupportFAQListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- FAQ 创建 ---
type SupportFAQCreateRequest {
	Category string `json:"category"`
	Question string `json:"question"`
	Answer   string `json:"answer"`
}

type SupportFAQCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- FAQ 更新 ---
type SupportFAQUpdateRequest {
	ID       string `path:"id"`
	Category string `json:"category,optional"`
	Question string `json:"question,optional"`
	Answer   string `json:"answer,optional"`
}

type SupportFAQUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- FAQ 删除 ---
type SupportFAQDeleteRequest {
	ID string `path:"id"`
}

type SupportFAQDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 反馈列表 ---
type SupportFeedbackListRequest {
	Page     int `form:"page,optional"`
	PageSize int `form:"pageSize,optional"`
}

type SupportFeedbackListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 反馈创建 ---
type SupportFeedbackCreateRequest {
	Type    string `json:"type"`
	Content string `json:"content"`
}

type SupportFeedbackCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 反馈更新 ---
type SupportFeedbackUpdateRequest {
	ID      string `path:"id"`
	Status  string `json:"status,optional"`
	Comment string `json:"comment,optional"`
}

type SupportFeedbackUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 反馈删除 ---
type SupportFeedbackDeleteRequest {
	ID string `path:"id"`
}

type SupportFeedbackDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/support
	group:  support
)
service server {
	// 工单相关
	@doc "获取工单列表"
	@handler SupportTicketsListHandler
	get /tickets (SupportTicketsListRequest) returns (SupportTicketsListResponse)

	@doc "创建工单"
	@handler SupportTicketCreateHandler
	post /tickets (SupportTicketCreateRequest) returns (SupportTicketCreateResponse)

	@doc "获取工单详情"
	@handler SupportTicketDetailHandler
	get /tickets/:id (SupportTicketDetailRequest) returns (SupportTicketDetailResponse)

	@doc "更新工单"
	@handler SupportTicketUpdateHandler
	put /tickets/:id (SupportTicketUpdateRequest) returns (SupportTicketUpdateResponse)

	@doc "删除工单"
	@handler SupportTicketDeleteHandler
	delete /tickets/:id (SupportTicketDeleteRequest) returns (SupportTicketDeleteResponse)

	@doc "工单状态转换"
	@handler SupportTicketTransitionHandler
	post /tickets/:id/transition (SupportTicketTransitionRequest) returns (SupportTicketTransitionResponse)

	// 评论相关
	@doc "获取工单评论"
	@handler SupportCommentsListHandler
	get /tickets/:ticketId/comments (SupportCommentsListRequest) returns (SupportCommentsListResponse)

	@doc "创建工单评论"
	@handler SupportCommentCreateHandler
	post /tickets/:ticketId/comments (SupportCommentCreateRequest) returns (SupportCommentCreateResponse)

	// FAQ 相关
	@doc "获取FAQ列表"
	@handler SupportFAQListHandler
	get /faq (SupportFAQListRequest) returns (SupportFAQListResponse)

	@doc "创建FAQ"
	@handler SupportFAQCreateHandler
	post /faq (SupportFAQCreateRequest) returns (SupportFAQCreateResponse)

	@doc "更新FAQ"
	@handler SupportFAQUpdateHandler
	put /faq/:id (SupportFAQUpdateRequest) returns (SupportFAQUpdateResponse)

	@doc "删除FAQ"
	@handler SupportFAQDeleteHandler
	delete /faq/:id (SupportFAQDeleteRequest) returns (SupportFAQDeleteResponse)

	// 反馈相关
	@doc "获取反馈列表"
	@handler SupportFeedbackListHandler
	get /feedback (SupportFeedbackListRequest) returns (SupportFeedbackListResponse)

	@doc "创建反馈"
	@handler SupportFeedbackCreateHandler
	post /feedback (SupportFeedbackCreateRequest) returns (SupportFeedbackCreateResponse)

	@doc "更新反馈"
	@handler SupportFeedbackUpdateHandler
	put /feedback/:id (SupportFeedbackUpdateRequest) returns (SupportFeedbackUpdateResponse)

	@doc "删除反馈"
	@handler SupportFeedbackDeleteHandler
	delete /feedback/:id (SupportFeedbackDeleteRequest) returns (SupportFeedbackDeleteResponse)
}
