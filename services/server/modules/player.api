// ============================================================================
// PLAYER 模块 API 定义 - 玩家管理
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================

// --- 玩家定义 ---
type Player {
	Id        int64    `json:"id"`
	Username  string   `json:"username"`
	Nickname  string   `json:"nickname"`
	Email     string   `json:"email"`
	Phone     string   `json:"phone"`
	GameId    string   `json:"gameId"`
	Status    int      `json:"status"` // 1:active 0:banned 2:suspended
	Balance   int64    `json:"balance"` // 游戏货币
	Level     int      `json:"level"`
	Vip       int      `json:"vip"`
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

// --- 玩家列表 ---
type PlayersListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	GameId   string `form:"gameId,optional"`
	Search   string `form:"search,optional"`
	Status   int    `form:"status,optional"`
	Level    int    `form:"level,optional"`
	Vip      int    `form:"vip,optional"`
}

type PlayersListResponse {
	Items []Player `json:"items"`
	Total int64    `json:"total"`
	Page  int      `json:"page"`
	Size  int      `json:"pageSize"`
}

// --- 玩家创建 ---
type PlayerCreateRequest {
	Username string `json:"username"`
	Password string `json:"password"`
	Nickname string `json:"nickname,optional"`
	Email    string `json:"email,optional"`
	Phone    string `json:"phone,optional"`
	GameId   string `json:"gameId"`
}

type PlayerCreateResponse {
	Player
}

// --- 玩家详情 ---
type PlayerDetailRequest {
	ID string `path:"id"`
}

type PlayerDetailResponse {
	Player
}

// --- 玩家更新 ---
type PlayerUpdateRequest {
	ID       string `path:"id"`
	Nickname string `json:"nickname,optional"`
	Email    string `json:"email,optional"`
	Phone    string `json:"phone,optional"`
	Status   int    `json:"status,optional"`
	Level    int    `json:"level,optional"`
	Vip      int    `json:"vip,optional"`
}

type PlayerUpdateResponse {
	Player
}

// --- 玩家删除 ---
type PlayerDeleteRequest {
	ID string `path:"id"`
}

// --- 玩家余额操作 ---
type PlayerBalanceRequest {
	ID      string `path:"id"`
	Amount  int64  `json:"amount"`
	Reason  string `json:"reason"`
}

type PlayerBalanceResponse {
	Player
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/players
	group:  player
)
service server {
	// === 玩家管理 ===
	@doc "获取玩家列表"
	@handler PlayersListHandler
	get / (PlayersListRequest) returns (PlayersListResponse)

	@doc "创建玩家"
	@handler PlayerCreateHandler
	post / (PlayerCreateRequest) returns (PlayerCreateResponse)

	@doc "获取玩家详情"
	@handler PlayerDetailHandler
	get /:id (PlayerDetailRequest) returns (PlayerDetailResponse)

	@doc "更新玩家信息"
	@handler PlayerUpdateHandler
	put /:id (PlayerUpdateRequest) returns (PlayerUpdateResponse)

	@doc "删除玩家"
	@handler PlayerDeleteHandler
	delete /:id (PlayerDeleteRequest)

	// === 玩家余额 ===
	@doc "调整玩家余额"
	@handler PlayerBalanceHandler
	post /:id/balance (PlayerBalanceRequest) returns (PlayerBalanceResponse)
}