// ============================================================================
// ENTITY 模块 API 定义 - RESTful 标准
// ============================================================================

// ============================================================================
// 请求类型
// ============================================================================
type EntitiesListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Type     string `form:"type,optional"`
}

type EntityCreateRequest {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

type EntityDetailRequest {
	ID string `path:"id"`
}

type EntityUpdateRequest {
	ID   string      `path:"id"`
	Data interface{} `json:"data"`
}

type EntityDeleteRequest {
	ID string `path:"id"`
}

type EntityValidateRequest {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

// ============================================================================
// 响应类型 - 直接返回数据，不包装 Code/Message
// ============================================================================
type Entity {
	Id         int64       `json:"id"`
	Type       string      `json:"type"`
	Data       interface{} `json:"data"`
	ProviderId string      `json:"providerId"`
	Status     int         `json:"status"`
	CreatedAt  string      `json:"createdAt"`
	UpdatedAt  string      `json:"updatedAt"`
}

// 列表响应
type EntitiesListResponse {
	Items []Entity `json:"items"`
	Total int64    `json:"total"`
	Page  int      `json:"page"`
	Size  int      `json:"pageSize"`
}

// 详情/创建/更新响应 - 直接返回实体
type EntityDetailResponse {
	Entity
}

// 验证响应
type EntityValidateResponse {
	Valid  bool     `json:"valid"`
	Errors []string `json:"errors,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/entities
	group:  entity
)
service server {
	@doc "获取实体列表"
	@handler EntitiesListHandler
	get / (EntitiesListRequest) returns (EntitiesListResponse)

	@doc "创建实体"
	@handler EntityCreateHandler
	post / (EntityCreateRequest) returns (EntityDetailResponse)

	@doc "获取实体详情"
	@handler EntityDetailHandler
	get /:id (EntityDetailRequest) returns (EntityDetailResponse)

	@doc "更新实体"
	@handler EntityUpdateHandler
	put /:id (EntityUpdateRequest) returns (EntityDetailResponse)

	@doc "删除实体"
	@handler EntityDeleteHandler
	delete /:id (EntityDeleteRequest)

	@doc "验证实体"
	@handler EntityValidateHandler
	post /validate (EntityValidateRequest) returns (EntityValidateResponse)
}
