// ============================================================================
// ANALYTICS RETENTION 模块 API 定义 - 留存和关卡分析
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- 留存分析 ---
type RetentionRequest {
	GameId    string `form:"gameId,optional"`
	Env       string `form:"env,optional"`
	Cohort    string `form:"cohort,optional"` // daily, weekly, monthly
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type RetentionCohort {
	Cohort    string    `json:"cohort"`
	Users     int       `json:"users"`
	Retention []float64 `json:"retention"` // Day 1, 3, 7, 14, 30
}

type RetentionResponse {
	Cohorts []RetentionCohort `json:"cohorts"`
}

// --- 关卡分析 ---
type LevelsRequest {
	GameId    string `form:"gameId,optional"`
	Env       string `form:"env,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type LevelMetrics {
	LevelId        string  `json:"levelId"`
	Attempts       int     `json:"attempts"`
	Completions    int     `json:"completions"`
	CompletionRate float64 `json:"completionRate"`
	AvgDuration    float64 `json:"avgDuration"`
	AvgRetries     float64 `json:"avgRetries"`
}

type LevelsResponse {
	Levels []LevelMetrics `json:"levels"`
}

// --- 章节分析 ---
type LevelsEpisodesRequest {
	GameId    string `form:"gameId,optional"`
	Env       string `form:"env,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type EpisodeMetrics {
	EpisodeId      string  `json:"episodeId"`
	Players        int     `json:"players"`
	CompletionRate float64 `json:"completionRate"`
	AvgProgress    float64 `json:"avgProgress"`
}

type LevelsEpisodesResponse {
	Episodes []EpisodeMetrics `json:"episodes"`
}

// --- 地图分析 ---
type LevelsMapsRequest {
	GameId    string `form:"gameId,optional"`
	Env       string `form:"env,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type MapMetrics {
	MapId      string      `json:"mapId"`
	HeatMap    interface{} `json:"heatMap"`
	DeathSpots interface{} `json:"deathSpots"`
}

type LevelsMapsResponse {
	Maps []MapMetrics `json:"maps"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/analytics
	group:  analytics_retention
)
service server {
	@doc "获取留存分析"
	@handler RetentionHandler
	get /retention (RetentionRequest) returns (RetentionResponse)

	@doc "获取关卡分析"
	@handler LevelsHandler
	get /levels (LevelsRequest) returns (LevelsResponse)

	@doc "获取章节分析"
	@handler LevelsEpisodesHandler
	get /levels/episodes (LevelsEpisodesRequest) returns (LevelsEpisodesResponse)

	@doc "获取地图分析"
	@handler LevelsMapsHandler
	get /levels/maps (LevelsMapsRequest) returns (LevelsMapsResponse)
}

