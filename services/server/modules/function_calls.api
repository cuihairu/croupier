// ============================================================================
// FUNCTION_CALLS 模块 API 定义
// ============================================================================
// 函数调用历史记录查询与重新执行
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================

type FunctionCallsListRequest {
	FunctionID string `form:"function_id,optional"`
	GameID     string `form:"game_id,optional"`
	Env        string `form:"env,optional"`
	Status     string `form:"status,optional"`
	ActorID    string `form:"actor_id,optional"`
	AgentID    string `form:"agent_id,optional"`
	StartTime  string `form:"start_time,optional"`
	EndTime    string `form:"end_time,optional"`
	Page       int    `form:"page,optional,default=1"`
	PageSize   int    `form:"page_size,optional,default=20"`
}

type FunctionCallsListResponse {
	Calls    []FunctionCallItem `json:"calls"`
	Total    int64              `json:"total"`
	Page     int                `json:"page"`
	PageSize int                `json:"page_size"`
}

type FunctionCallItem {
	ID          int64       `json:"id"`
	JobID       string      `json:"job_id"`
	FunctionID  string      `json:"function_id"`
	GameID      string      `json:"game_id,omitempty"`
	Env         string      `json:"env,omitempty"`
	ActorID     string      `json:"actor_id,omitempty"`
	ActorType   string      `json:"actor_type,omitempty"`
	Status      string      `json:"status"`
	AgentID     string      `json:"agent_id,omitempty"`
	ServiceID   string      `json:"service_id,omitempty"`
	StartedAt   string      `json:"started_at,omitempty"`
	FinishedAt  string      `json:"finished_at,omitempty"`
	DurationMs  int64       `json:"duration_ms,omitempty"`
	Payload     interface{} `json:"payload,omitempty"`
	Result      interface{} `json:"result,omitempty"`
	ErrorMsg    string      `json:"error_msg,omitempty"`
	RetryCount  int         `json:"retry_count,omitempty"`
	CreatedAt   string      `json:"created_at"`
}

type FunctionCallDetailRequest {
	ID string `path:"id"`
}

type FunctionCallDetailResponse {
	FunctionCallItem
}

type FunctionCallRerunRequest {
	ID     string      `path:"id"`
	Payload interface{} `json:"payload,optional"`
}

type FunctionCallRerunResponse {
	JobID string `json:"job_id"`
}

type FunctionCallStatsRequest {
	FunctionID string `form:"function_id,optional"`
	GameID     string `form:"game_id,optional"`
	Env        string `form:"env,optional"`
	ActorID    string `form:"actor_id,optional"`
	StartTime  string `form:"start_time,optional"`
	EndTime    string `form:"end_time,optional"`
}

type FunctionCallStatsResponse {
	Total         int64 `json:"total"`
	Succeeded     int64 `json:"succeeded"`
	Failed        int64 `json:"failed"`
	Running       int64 `json:"running"`
	Cancelled     int64 `json:"cancelled"`
	Timeout       int64 `json:"timeout"`
	Other         int64 `json:"other"`
	AvgDurationMs int64 `json:"avg_duration_ms"`
}

// ============================================================================
// 服务定义
// ============================================================================

@server (
	prefix: /api/v1/function-calls
	group:  function_calls
)
service server {
	@doc "获取函数调用历史列表"
	@handler FunctionCallsListHandler
	get / (FunctionCallsListRequest) returns (FunctionCallsListResponse)

	@doc "获取单条调用历史详情"
	@handler FunctionCallDetailHandler
	get /:id (FunctionCallDetailRequest) returns (FunctionCallDetailResponse)

	@doc "重新执行失败的调用"
	@handler FunctionCallRerunHandler
	post /:id/rerun (FunctionCallRerunRequest) returns (FunctionCallRerunResponse)

	@doc "获取调用统计"
	@handler FunctionCallStatsHandler
	get /stats (FunctionCallStatsRequest) returns (FunctionCallStatsResponse)
}
