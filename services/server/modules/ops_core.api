// ============================================================================
// OPS 模块 API 定义 - 核心运维操作
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================

// --- 运维配置 ---
type OpsConfigRequest {}

type OpsConfig {
	MaintenanceMode bool        `json:"maintenanceMode"`
	HealthCheck     interface{} `json:"healthCheck"`
	Notifications   interface{} `json:"notifications"`
}

type OpsConfigResponse {
	OpsConfig
}

// --- 服务列表 ---
type OpsServicesRequest {}

type OpsService {
	Name    string `json:"name"`
	Status  string `json:"status"`
	Version string `json:"version"`
	Uptime  int64  `json:"uptime"`
}

type OpsServicesResponse {
	Items []OpsService `json:"items"`
}

// --- 函数列表（运维视角）---
type OpsFunctionsRequest {
	GameId string `form:"gameId,optional"`
}

type OpsFunction {
	Id        string `json:"id"`
	Name      string `json:"name"`
	GameId    string `json:"gameId"`
	Instances int    `json:"instances"`
	Status    string `json:"status"`
}

type OpsFunctionsResponse {
	Items []OpsFunction `json:"items"`
}

// --- 指标 ---
type OpsMetricsRequest {
	From string `form:"from,optional"`
	To   string `form:"to,optional"`
}

type OpsMetricsResponse {
	CPU    interface{} `json:"cpu"`
	Memory interface{} `json:"memory"`
	QPS    interface{} `json:"qps"`
}

// --- 消息队列状态 ---
type OpsMQRequest {}

type OpsMQResponse {
	Status interface{} `json:"status"`
}

// --- 维护模式 ---
type OpsMaintenanceGetRequest {}

type OpsMaintenanceResponse {
	Enabled bool   `json:"enabled"`
	Reason  string `json:"reason"`
	StartAt string `json:"startAt"`
	EndAt   string `json:"endAt"`
}

type OpsMaintenanceUpdateRequest {
	Enabled bool   `json:"enabled"`
	Reason  string `json:"reason,optional"`
	EndAt   string `json:"endAt,optional"`
}

// --- 健康检查 ---
type OpsHealthGetRequest {}

type OpsHealthResponse {
	Status string      `json:"status"`
	Checks interface{} `json:"checks"`
}

type OpsHealthRunRequest {}

type OpsHealthUpdateRequest {
	Config interface{} `json:"config"`
}

// --- 通知配置 ---
type OpsNotificationsGetRequest {}

type OpsNotificationsResponse {
	Email   interface{} `json:"email"`
	Webhook interface{} `json:"webhook"`
	Slack   interface{} `json:"slack"`
}

type OpsNotificationsUpdateRequest {
	Email   interface{} `json:"email,optional"`
	Webhook interface{} `json:"webhook,optional"`
	Slack   interface{} `json:"slack,optional"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/ops
	group:  ops
)
service server {
	@doc "获取运维配置"
	@handler OpsConfigHandler
	get /config (OpsConfigRequest) returns (OpsConfigResponse)

	@doc "获取服务列表"
	@handler OpsServicesHandler
	get /services (OpsServicesRequest) returns (OpsServicesResponse)

	@doc "获取函数列表"
	@handler OpsFunctionsHandler
	get /functions (OpsFunctionsRequest) returns (OpsFunctionsResponse)

	@doc "获取系统指标"
	@handler OpsMetricsHandler
	get /metrics (OpsMetricsRequest) returns (OpsMetricsResponse)

	@doc "获取消息队列状态"
	@handler OpsMQHandler
	get /mq (OpsMQRequest) returns (OpsMQResponse)

	@doc "获取维护模式状态"
	@handler OpsMaintenanceGetHandler
	get /maintenance (OpsMaintenanceGetRequest) returns (OpsMaintenanceResponse)

	@doc "更新维护模式"
	@handler OpsMaintenanceUpdateHandler
	put /maintenance (OpsMaintenanceUpdateRequest) returns (OpsMaintenanceResponse)

	@doc "获取健康状态"
	@handler OpsHealthGetHandler
	get /health (OpsHealthGetRequest) returns (OpsHealthResponse)

	@doc "运行健康检查"
	@handler OpsHealthRunHandler
	post /health/run (OpsHealthRunRequest) returns (OpsHealthResponse)

	@doc "更新健康检查配置"
	@handler OpsHealthUpdateHandler
	put /health (OpsHealthUpdateRequest) returns (OpsHealthResponse)

	@doc "获取通知配置"
	@handler OpsNotificationsGetHandler
	get /notifications (OpsNotificationsGetRequest) returns (OpsNotificationsResponse)

	@doc "更新通知配置"
	@handler OpsNotificationsUpdateHandler
	put /notifications (OpsNotificationsUpdateRequest) returns (OpsNotificationsResponse)
}
