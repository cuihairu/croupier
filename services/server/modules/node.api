// ============================================================================
// NODE 模块 API 定义 - 节点管理
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================
type Node {
	Id        string      `json:"id"`
	Name      string      `json:"name"`
	Type      string      `json:"type"` // server, agent
	Status    string      `json:"status"`
	IP        string      `json:"ip"`
	Port      int         `json:"port"`
	Resources interface{} `json:"resources"`
	UpdatedAt string      `json:"updatedAt"`
}

// --- 节点列表 ---
type NodesListRequest {
	Type   string `form:"type,optional"`
	Status string `form:"status,optional"`
}

type NodesListResponse {
	Items []Node `json:"items"`
}

// --- 节点元数据 ---
type NodeMetaRequest {
	ID string `path:"id"`
}

type NodeMetaResponse {
	Meta interface{} `json:"meta"`
}

type NodeMetaUpdateRequest {
	ID   string      `path:"id"`
	Meta interface{} `json:"meta"`
}

// --- 节点操作 ---
type NodeActionRequest {
	ID string `path:"id"`
}

type NodeDrainRequest {
	ID      string `path:"id"`
	Timeout int    `json:"timeout,optional"` // 秒
}

// --- 节点命令 ---
type NodeCommandsRequest {}

type NodeCommand {
	Name        string `json:"name"`
	Description string `json:"description"`
}

type NodeCommandsResponse {
	Items []NodeCommand `json:"items"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/nodes
	group:  node
)
service server {
	@doc "获取节点列表"
	@handler NodesListHandler
	get / (NodesListRequest) returns (NodesListResponse)

	@doc "获取节点元数据"
	@handler NodeMetaHandler
	get /:id/meta (NodeMetaRequest) returns (NodeMetaResponse)

	@doc "更新节点元数据"
	@handler NodeMetaUpdateHandler
	put /:id/meta (NodeMetaUpdateRequest) returns (NodeMetaResponse)

	@doc "排空节点"
	@handler NodeDrainHandler
	post /:id/drain (NodeDrainRequest)

	@doc "取消排空节点"
	@handler NodeUndrainHandler
	post /:id/undrain (NodeActionRequest)

	@doc "重启节点"
	@handler NodeRestartHandler
	post /:id/restart (NodeActionRequest)

	@doc "获取节点命令"
	@handler NodeCommandsHandler
	get /commands (NodeCommandsRequest) returns (NodeCommandsResponse)
}
