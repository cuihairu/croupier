// ============================================================================
// SCHEMA 模块 API 定义 - Schema 管理
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- Schema 列表 ---
type SchemasListRequest {
	Page     int `form:"page,optional"`
	PageSize int `form:"pageSize,optional"`
}

type SchemasListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 创建 ---
type SchemaCreateRequest {
	Name   string      `json:"name"`
	Schema interface{} `json:"schema"`
}

type SchemaCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 详情 ---
type SchemaDetailRequest {
	ID string `path:"id"`
}

type SchemaDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 更新 ---
type SchemaUpdateRequest {
	ID     string      `path:"id"`
	Schema interface{} `json:"schema"`
}

type SchemaUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 删除 ---
type SchemaDeleteRequest {
	ID string `path:"id"`
}

type SchemaDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 验证 ---
type SchemaValidateRequest {
	ID   string      `path:"id"`
	Data interface{} `json:"data"`
}

type SchemaValidateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema 原始验证 ---
type SchemaRawValidateRequest {
	Schema interface{} `json:"schema"`
	Data   interface{} `json:"data"`
}

type SchemaRawValidateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Schema UI 配置 ---
type SchemaUIConfigRequest {
	ID string `path:"id"`
}

type SchemaUIConfigResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type SchemaUIConfigUpdateRequest {
	ID     string      `path:"id"`
	Config interface{} `json:"config"`
}

type SchemaUIConfigUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/schemas
	group:  schema
)
service server {
	@doc "获取模式列表"
	@handler SchemasListHandler
	get / (SchemasListRequest) returns (SchemasListResponse)

	@doc "创建模式"
	@handler SchemaCreateHandler
	post / (SchemaCreateRequest) returns (SchemaCreateResponse)

	@doc "获取模式详情"
	@handler SchemaDetailHandler
	get /:id (SchemaDetailRequest) returns (SchemaDetailResponse)

	@doc "更新模式"
	@handler SchemaUpdateHandler
	put /:id (SchemaUpdateRequest) returns (SchemaUpdateResponse)

	@doc "删除模式"
	@handler SchemaDeleteHandler
	delete /:id (SchemaDeleteRequest) returns (SchemaDeleteResponse)

	@doc "验证模式数据"
	@handler SchemaValidateHandler
	post /:id/validate (SchemaValidateRequest) returns (SchemaValidateResponse)

	@doc "原始模式验证"
	@handler SchemaRawValidateHandler
	post /raw-validate (SchemaRawValidateRequest) returns (SchemaRawValidateResponse)

	@doc "获取模式UI配置"
	@handler SchemaUiConfigHandler
	get /:id/ui-config (SchemaUIConfigRequest) returns (SchemaUIConfigResponse)

	@doc "更新模式UI配置"
	@handler SchemaUiConfigUpdateHandler
	put /:id/ui-config (SchemaUIConfigUpdateRequest) returns (SchemaUIConfigUpdateResponse)
}
