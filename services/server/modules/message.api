// ============================================================================
// MESSAGE 模块 API 定义
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- 消息列表 ---
type MessagesListRequest {
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
	Type     string `form:"type,optional"`
	Status   string `form:"status,optional"`
}

type MessagesListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 消息详情 ---
type MessageDetailRequest {
	ID string `path:"id"`
}

type MessageDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 发送消息 ---
type MessageSendRequest {
	To      string      `json:"to"`
	Type    string      `json:"type"`
	Title   string      `json:"title,optional"`
	Content string      `json:"content"`
	Data    interface{} `json:"data,optional"`
}

type MessageSendResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 标记已读 ---
type MessageReadRequest {
	ID string `path:"id"`
}

type MessageReadResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 未读数量 ---
type MessagesUnreadCountRequest {}

type MessagesUnreadCountResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 消息流 ---
type StreamMessagesRequest {}

type StreamMessagesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/messages
	group:  message
)
service server {
	@doc "获取消息列表"
	@handler MessagesListHandler
	get / (MessagesListRequest) returns (MessagesListResponse)

	@doc "发送消息"
	@handler MessageSendHandler
	post / (MessageSendRequest) returns (MessageSendResponse)

	@doc "获取消息详情"
	@handler MessageDetailHandler
	get /:id (MessageDetailRequest) returns (MessageDetailResponse)

	@doc "标记消息已读"
	@handler MessageReadHandler
	post /:id/read (MessageReadRequest) returns (MessageReadResponse)

	@doc "获取未读消息数量"
	@handler MessagesUnreadCountHandler
	get /unread-count (MessagesUnreadCountRequest) returns (MessagesUnreadCountResponse)

	@doc "消息流（实时推送）"
	@handler StreamMessagesHandler
	get /stream (StreamMessagesRequest) returns (StreamMessagesResponse)
}

