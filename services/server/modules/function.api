// ============================================================================
// FUNCTION 模块 API 定义 - 函数管理（合并 function + permission + ui）
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================
type Function {
	Id          string      `json:"id"`
	Name        string      `json:"name"`
	Description string      `json:"description"`
	Category    string      `json:"category"`
	GameId      string      `json:"gameId"`
	Status      int         `json:"status"`
	Version     string      `json:"version"`
	Instances   int         `json:"instances"`
	SpecFormat  string      `json:"specFormat,optional"`
	OpenAPISpec interface{} `json:"openapiSpec,optional"`
	CreatedAt   string      `json:"createdAt"`
	UpdatedAt   string      `json:"updatedAt"`
}

// --- 函数列表 ---
type FunctionsListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	GameId   string `form:"gameId,optional"`
	Category string `form:"category,optional"`
	Status   int    `form:"status,optional"`
}

type FunctionsListResponse {
	Items []Function `json:"items"`
	Total int64      `json:"total"`
	Page  int        `json:"page"`
	Size  int        `json:"pageSize"`
}

// --- 函数详情 ---
type FunctionDetailRequest {
	ID string `path:"id"`
}

type FunctionDescriptor {
	Input  interface{} `json:"input"`
	Output interface{} `json:"output"`
	Schema interface{} `json:"schema"`
}

type FunctionDetailResponse {
	Function
	Descriptor FunctionDescriptor `json:"descriptor"`
}

// --- 函数描述符列表 ---
type DescriptorsRequest {
	Type   string `form:"type,optional"`
	GameId string `form:"gameId,optional"`
}

type Descriptor {
	Id          string      `json:"id"`
	Name        string      `json:"name"`
	Description string      `json:"description"`
	Category    string      `json:"category"`
	Schema      interface{} `json:"schema"`
}

type DescriptorsResponse {
	Items []Descriptor `json:"items"`
}

// --- 函数实例 ---
type FunctionInstancesRequest {
	ID string `path:"id"`
}

type FunctionInstancesAllRequest {
}

type FunctionInstance {
	AgentId   string `json:"agentId"`
	AgentName string `json:"agentName"`
	Status    string `json:"status"`
	UpdatedAt string `json:"updatedAt"`
}

type FunctionInstancesResponse {
	Items []FunctionInstance `json:"items"`
}

type FunctionInstancesAllResponse {
	Instances []map[string]interface{} `json:"instances"`
}

// --- 函数操作 ---
type FunctionActionRequest {
	ID string `path:"id"`
}

type FunctionCopyRequest {
	ID string `path:"id"`
}

type FunctionCopyResponse {
	FunctionId string `json:"function_id"`
	NewId      string `json:"new_id"`
}

// --- 函数调用 ---
type FunctionInvokeRequest {
	ID              string      `path:"id"`
	Params          interface{} `json:"params,optional"`
	Payload         interface{} `json:"payload,optional"`
	GameID          string      `json:"gameId,optional"`
	Env             string      `json:"env,optional"`
	Mode            string      `json:"mode,optional"`
	Route           string      `json:"route,optional"`
	TargetServiceID string      `json:"target_service_id,optional"`
	HashKey         string      `json:"hash_key,optional"`
}

type FunctionInvokeResponse {
	JobId   string      `json:"jobId"`
	JobID   string      `json:"jobID,omitempty"`
	Result  interface{} `json:"result,omitempty"`
}

// --- 函数权限 ---
type FunctionPermissionsRequest {
	ID string `path:"id"`
}

type FunctionPermission {
	Resource string   `json:"resource"`
	Actions  []string `json:"actions"`
	Roles    []string `json:"roles"`
}

type FunctionPermissionsResponse {
	Items []FunctionPermission `json:"items"`
}

type FunctionPermissionsUpdateRequest {
	ID          string               `path:"id"`
	Permissions []FunctionPermission `json:"permissions"`
}

// --- 函数 UI 配置 ---
type FunctionUIRequest {
	ID string `path:"id"`
}

type FunctionUIResponse {
	Schema     interface{} `json:"schema"`
	Layout     interface{} `json:"layout"`
	Components interface{} `json:"components"`
	Custom     bool        `json:"custom"`
	HasDefault bool        `json:"hasDefault"`
	UISource       string `json:"uiSource,optional"`       // custom_metadata/config_file_override/openapi_x_ui/none
	UISourceDetail string `json:"uiSourceDetail,optional"` // human-readable source description
}

type FunctionUIUpdateRequest {
	ID         string      `path:"id"`
	Schema     interface{} `json:"schema,optional"`
	Layout     interface{} `json:"layout,optional"`
	Components interface{} `json:"components,optional"`
}

type FunctionUIHistoryRequest {
	ID string `path:"id"`
}

type FunctionUIHistoryItem {
	Version    int         `json:"version"`
	Schema     interface{} `json:"schema,optional"`
	Layout     interface{} `json:"layout,optional"`
	Components interface{} `json:"components,optional"`
	Message    string      `json:"message,optional"`
	CreatedBy  string      `json:"createdBy,optional"`
	CreatedAt  string      `json:"createdAt,optional"`
}

type FunctionUIHistoryResponse {
	Items []FunctionUIHistoryItem `json:"items"`
}

type FunctionUIRollbackRequest {
	ID      string `path:"id"`
	Version int    `json:"version"`
}

type FunctionUIRollbackResponse {
	AppliedVersion int                 `json:"appliedVersion"`
	Current        *FunctionUIResponse `json:"current"`
}

// --- 函数路由配置 ---
type FunctionRouteRequest {
	ID string `path:"id"`
}

type FunctionRouteConfig {
	Nodes  []string `json:"nodes"`
	Path    string `json:"path"`
	Order   int    `json:"order"`
	Hidden  bool   `json:"hidden"`
}

type FunctionRouteResponse {
	Menu   FunctionRouteConfig `json:"menu"`
	Source string              `json:"source,optional"`
}

type FunctionRouteUpdateRequest {
	ID     string   `path:"id"`
	Nodes  []string `json:"nodes,optional"`
	Path   string   `json:"path,optional"`
	Order  int      `json:"order,optional"`
	Hidden bool     `json:"hidden,optional"`
}

// --- 函数历史 ---
type FunctionHistoryRequest {
	ID string `path:"id"`
}

type FunctionHistoryItem {
	ID        string      `json:"id"`
	Action    string      `json:"action"`
	Operator  string      `json:"operator,optional"`
	Timestamp string      `json:"timestamp"`
	Details   interface{} `json:"details,optional"`
}

// --- 函数分析 ---
type FunctionAnalyticsRequest {
	ID string `path:"id"`
}

type FunctionAnalyticsResponse {
	TotalCalls     int64   `json:"totalCalls"`
	SuccessRate    float64 `json:"successRate"`
	AvgLatency     float64 `json:"avgLatency"`
	CallsToday     int64   `json:"callsToday"`
	CallsThisWeek  int64   `json:"callsThisWeek"`
	CallsThisMonth int64   `json:"callsThisMonth"`
}

// --- 函数发布 ---
type FunctionPublishRequest {
	ID string `path:"id"`
}

type FunctionPublishResponse {
	ApprovalId string `json:"approvalId,omitempty"` // 如果需要审批
	Published  bool   `json:"published"`
}

// --- 待处理函数 ---
type FunctionsPendingRequest {}

type PendingFunction {
	Id        string `json:"id"`
	Name      string `json:"name"`
	Status    string `json:"status"`
	Requester string `json:"requester"`
	CreatedAt string `json:"createdAt"`
}

type FunctionsPendingResponse {
	Items []PendingFunction `json:"items"`
}

// --- 批量操作 ---
type BatchUpdateFunctionsRequest {
	FunctionIds []string `json:"function_ids"`
	Enabled     bool     `json:"enabled"`
}

type BatchUpdateFunctionsResponse {
	Updated int      `json:"updated"`
	Failed  []string `json:"failed"`
}

type BatchCopyFunctionsRequest {
	FunctionIds []string `json:"function_ids"`
}

type BatchCopyFunctionsResponse {
	Updated int      `json:"updated"`
	Failed  []string `json:"failed"`
	Copied  []string `json:"copied"` // 新复制的函数ID列表
}

type BatchDeleteFunctionsRequest {
	FunctionIds []string `json:"function_ids"`
}

type BatchDeleteFunctionsResponse {
	Updated int      `json:"updated"`
	Failed  []string `json:"failed"`
}

// --- 注册告警 ---
type FunctionWarningsRequest {
	FunctionID string `form:"function_id,optional"`
	AgentID    string `form:"agent_id,optional"`
	Code       string `form:"code,optional"`
	Limit      int    `form:"limit,optional,default=100"`
}

type FunctionWarningItem {
	Key        string `json:"key"`
	AgentID    string `json:"agent_id"`
	FunctionID string `json:"function_id"`
	Version    string `json:"version"`
	Code       string `json:"code"`
	Message    string `json:"message"`
	Count      int    `json:"count"`
	FirstSeen  string `json:"first_seen"`
	LastSeen   string `json:"last_seen"`
}

type FunctionWarningsResponse {
	Items []FunctionWarningItem `json:"items"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/functions
	group:  function
)
service server {
	// === 基础 CRUD ===
	@doc "获取函数列表"
	@handler FunctionsListHandler
	get / (FunctionsListRequest) returns (FunctionsListResponse)

	@doc "获取函数详情"
	@handler FunctionDetailHandler
	get /:id (FunctionDetailRequest) returns (FunctionDetailResponse)

	// === 函数操作 ===
	@doc "启用函数"
	@handler FunctionEnableHandler
	post /:id/enable (FunctionActionRequest)

	@doc "禁用函数"
	@handler FunctionDisableHandler
	post /:id/disable (FunctionActionRequest)

	@doc "复制函数"
	@handler FunctionCopyHandler
	post /:id/copy (FunctionCopyRequest) returns (FunctionCopyResponse)

	@doc "删除函数"
	@handler FunctionDeleteHandler
	delete /:id (FunctionActionRequest)

	@doc "调用函数"
	@handler FunctionInvokeHandler
	post /:id/invoke (FunctionInvokeRequest) returns (FunctionInvokeResponse)

	@doc "发布函数"
	@handler FunctionPublishHandler
	post /:id/publish (FunctionPublishRequest) returns (FunctionPublishResponse)

	// === 函数实例 ===
	@doc "获取函数实例"
	@handler FunctionInstancesHandler
	get /:id/instances (FunctionInstancesRequest) returns (FunctionInstancesResponse)

	@doc "获取所有函数实例"
	@handler FunctionInstancesAllHandler
	get /instances (FunctionInstancesAllRequest) returns (FunctionInstancesAllResponse)

	// === 权限管理 ===
	@doc "获取函数权限"
	@handler FunctionPermissionsHandler
	get /:id/permissions (FunctionPermissionsRequest) returns (FunctionPermissionsResponse)

	@doc "更新函数权限"
	@handler FunctionPermissionsUpdateHandler
	put /:id/permissions (FunctionPermissionsUpdateRequest) returns (FunctionPermissionsResponse)

	// === UI 配置 ===
	@doc "获取函数UI配置"
	@handler FunctionUIHandler
	get /:id/ui (FunctionUIRequest) returns (FunctionUIResponse)

	@doc "更新函数UI配置"
	@handler FunctionUIUpdateHandler
	put /:id/ui (FunctionUIUpdateRequest) returns (FunctionUIResponse)

	@doc "获取函数UI配置历史"
	@handler FunctionUIHistoryHandler
	get /:id/ui/history (FunctionUIHistoryRequest) returns (FunctionUIHistoryResponse)

	@doc "回滚函数UI配置"
	@handler FunctionUIRollbackHandler
	post /:id/ui/rollback (FunctionUIRollbackRequest) returns (FunctionUIRollbackResponse)

	@doc "获取函数路由配置"
	@handler FunctionRouteHandler
	get /:id/route (FunctionRouteRequest) returns (FunctionRouteResponse)

	@doc "更新函数路由配置"
	@handler FunctionRouteUpdateHandler
	put /:id/route (FunctionRouteUpdateRequest) returns (FunctionRouteResponse)

	@doc "获取函数变更历史"
	@handler FunctionHistoryHandler
	get /:id/history (FunctionHistoryRequest) returns ([]FunctionHistoryItem)

	@doc "获取函数分析数据"
	@handler FunctionAnalyticsHandler
	get /:id/analytics (FunctionAnalyticsRequest) returns (FunctionAnalyticsResponse)

	// === 描述符 ===
	@doc "获取函数描述符列表"
	@handler DescriptorsHandler
	get /descriptors (DescriptorsRequest) returns (DescriptorsResponse)

	// === 待处理 ===
	@doc "获取待处理函数"
	@handler FunctionsPendingHandler
	get /pending (FunctionsPendingRequest) returns (FunctionsPendingResponse)

	// === 批量操作 ===
	@doc "批量更新函数状态"
	@handler BatchUpdateFunctionsHandler
	post /batch-update (BatchUpdateFunctionsRequest) returns (BatchUpdateFunctionsResponse)

	@doc "批量复制函数"
	@handler BatchCopyFunctionsHandler
	post /batch-copy (BatchCopyFunctionsRequest) returns (BatchCopyFunctionsResponse)

	@doc "批量删除函数"
	@handler BatchDeleteFunctionsHandler
	post /batch-delete (BatchDeleteFunctionsRequest) returns (BatchDeleteFunctionsResponse)

	@doc "查询函数注册告警"
	@handler FunctionWarningsHandler
	get /warnings (FunctionWarningsRequest) returns (FunctionWarningsResponse)
}
