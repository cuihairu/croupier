// ============================================================================
// PLATFORM 模块 API 定义 - 第三方运营平台集成
// ============================================================================
// 支持第三方运营平台（如 QuickSDK）的数据接入
// ============================================================================

// ============================================================================
// 类型定义
// ============================================================================

// --- 调用平台 API ---
type CallPlatformRequest {
	Platform string  `json:"platform"` // 平台名称，如 "quicksdk"
	Method   string  `json:"method"`   // API 方法名
	Request  string  `json:"request"`  // 请求参数（JSON 字符串格式）
}

type CallPlatformResponse {
	Code     int         `json:"code"`
	Message  string      `json:"message"`
	Response interface{} `json:"response,omitempty"` // 平台返回的响应
}

// --- 平台列表 ---
type PlatformInfo {
	Name     string   `json:"name"`     // 平台名称
	Enabled  bool     `json:"enabled"`  // 是否启用
	Methods  []string `json:"methods"`  // 支持的方法列表
}

type ListPlatformsResponse {
	Code      int            `json:"code"`
	Message   string         `json:"message"`
	Platforms []PlatformInfo `json:"platforms,omitempty"`
}

// --- 平台方法列表 ---
type ListPlatformMethodsResponse {
	Code    int      `json:"code"`
	Message string   `json:"message"`
	Methods []string `json:"methods,omitempty"`
}

// --- 重载平台配置 ---
type ReloadPlatformConfigResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Success bool   `json:"success,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================

@server (
	prefix: /api/v1/platforms
	group:  platform
)
service server {
	@doc "调用第三方平台 API"
	@handler CallPlatformHandler
	post /call (CallPlatformRequest) returns (CallPlatformResponse)

	@doc "获取所有可用的第三方平台列表"
	@handler ListPlatformsHandler
	get / returns (ListPlatformsResponse)

	@doc "获取指定平台支持的方法列表"
	@handler ListPlatformMethodsHandler
	get /:platform/methods returns (ListPlatformMethodsResponse)

	@doc "重新加载平台配置"
	@handler ReloadPlatformConfigHandler
	post /reload returns (ReloadPlatformConfigResponse)
}
