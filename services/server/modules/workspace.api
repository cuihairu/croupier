// ============================================================================
// WORKSPACE 模块 API 定义 - 对象工作平台配置管理
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================

// --- Workspace 配置元数据 ---
type WorkspaceConfigMeta {
	CreatedAt string `json:"createdAt,omitempty"`
	UpdatedAt string `json:"updatedAt,omitempty"`
}

// --- Workspace 配置 ---
type WorkspaceConfig {
	ObjectKey   string              `json:"objectKey"`
	Title       string              `json:"title,omitempty"`
	Description string              `json:"description,omitempty"`
	Layout      interface{}         `json:"layout,omitempty"`
	Published   bool                `json:"published"`
	Status      string              `json:"status,omitempty"`
	PublishedAt string              `json:"publishedAt,omitempty"`
	PublishedBy string              `json:"publishedBy,omitempty"`
	MenuOrder   int                 `json:"menuOrder"`
	Version    int                 `json:"version,omitempty"`
	Meta        WorkspaceConfigMeta `json:"meta,omitempty"`
}

// --- 获取配置列表 ---
type WorkspaceConfigsListRequest {
}

type WorkspaceConfigsListResponse {
	Items []WorkspaceConfig `json:"items"`
}

// --- 获取单个配置 ---
type WorkspaceConfigGetRequest {
	ObjectKey string `path:"objectKey"`
}

type WorkspaceConfigGetResponse {
	WorkspaceConfig
}

// --- 保存配置 ---
type WorkspaceConfigSaveRequest {
	ObjectKey string      `path:"objectKey"`
	Title     string      `json:"title,omitempty"`
	Description string      `json:"description,omitempty"`
	Layout    interface{} `json:"layout,omitempty"`
	Status    string      `json:"status,optional"`
	MenuOrder int         `json:"menuOrder,optional"`
}

type WorkspaceConfigSaveResponse {
	WorkspaceConfig
}

// --- 删除配置 ---
type WorkspaceConfigDeleteRequest {
	ObjectKey string `path:"objectKey"`
}

type WorkspaceConfigDeleteResponse {
	Message string `json:"message"`
}

// --- 发布配置 ---
type WorkspacePublishRequest {
	ObjectKey   string `path:"objectKey"`
	PublishedBy string `json:"publishedBy,optional"`
}

type WorkspacePublishResponse {
	Published bool   `json:"published"`
	ObjectKey string `json:"objectKey"`
}

// --- 取消发布配置 ---
type WorkspaceUnpublishRequest {
	ObjectKey string `path:"objectKey"`
}

type WorkspaceUnpublishResponse {
	Published bool   `json:"published"`
	ObjectKey string `json:"objectKey"`
}

// --- 获取已发布配置列表 ---
type WorkspacePublishedListRequest {
}

type WorkspacePublishedListResponse {
	Items []WorkspaceConfig `json:"items"`
}

// --- Workspace 版本列表 ---
type WorkspaceVersionsRequest {
	ObjectKey string `path:"objectKey"`
	From      string `form:"from,optional"`
	To        string `form:"to,optional"`
}

type WorkspaceVersionRecord {
	Id        string      `json:"id"`
	ObjectKey string      `json:"objectKey"`
	Version   int         `json:"version"`
	Config    interface{} `json:"config"`
	IsCurrentDraft    bool        `json:"isCurrentDraft,optional"`
	IsCurrentPublished bool       `json:"isCurrentPublished,optional"`
	CreatedAt string      `json:"createdAt,omitempty"`
	CreatedBy string      `json:"createdBy,omitempty"`
	Comment   string      `json:"comment,omitempty"`
}

type WorkspaceVersionsResponse {
	Items []WorkspaceVersionRecord `json:"items"`
	CurrentDraftVersion int        `json:"currentDraftVersion,optional"`
	CurrentPublishedVersion int    `json:"currentPublishedVersion,optional"`
}

// --- Workspace 单版本详情 ---
type WorkspaceVersionDetailRequest {
	ObjectKey string `path:"objectKey"`
	VersionId string `path:"versionId"`
}

type WorkspaceVersionDetailResponse {
	WorkspaceVersionRecord
}

// --- 回滚 ---
type WorkspaceRollbackRequest {
	ObjectKey string `path:"objectKey"`
	VersionId string `json:"versionId"`
}

type WorkspaceRollbackResponse {
	ObjectKey string `json:"objectKey"`
	Version   int    `json:"version"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/workspaces
	group:  workspace
)
service server {
	@doc "获取所有 Workspace 配置列表"
	@handler WorkspaceConfigsListHandler
	get /configs (WorkspaceConfigsListRequest) returns (WorkspaceConfigsListResponse)

	@doc "获取已发布的 Workspace 配置列表"
	@handler WorkspacePublishedListHandler
	get /published (WorkspacePublishedListRequest) returns (WorkspacePublishedListResponse)

	@doc "获取单个 Workspace 配置"
	@handler WorkspaceConfigGetHandler
	get /:objectKey/config (WorkspaceConfigGetRequest) returns (WorkspaceConfigGetResponse)

	@doc "保存 Workspace 配置（创建或更新）"
	@handler WorkspaceConfigSaveHandler
	put /:objectKey/config (WorkspaceConfigSaveRequest) returns (WorkspaceConfigSaveResponse)

	@doc "删除 Workspace 配置"
	@handler WorkspaceConfigDeleteHandler
	delete /:objectKey/config (WorkspaceConfigDeleteRequest) returns (WorkspaceConfigDeleteResponse)

	@doc "发布 Workspace 配置"
	@handler WorkspacePublishHandler
	post /:objectKey/publish (WorkspacePublishRequest) returns (WorkspacePublishResponse)

	@doc "取消发布 Workspace 配置"
	@handler WorkspaceUnpublishHandler
	post /:objectKey/unpublish (WorkspaceUnpublishRequest) returns (WorkspaceUnpublishResponse)

	@doc "获取 Workspace 版本列表"
	@handler WorkspaceVersionsHandler
	get /:objectKey/versions (WorkspaceVersionsRequest) returns (WorkspaceVersionsResponse)

	@doc "获取 Workspace 单个版本详情"
	@handler WorkspaceVersionDetailHandler
	get /:objectKey/versions/:versionId (WorkspaceVersionDetailRequest) returns (WorkspaceVersionDetailResponse)

	@doc "回滚 Workspace 到指定版本"
	@handler WorkspaceRollbackHandler
	post /:objectKey/rollback (WorkspaceRollbackRequest) returns (WorkspaceRollbackResponse)
}
