// ============================================================================
// JOB 模块 API 定义
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
type JobCancelRequest {
	ID string `path:"id"` // 任务ID
}

type JobCancelResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type JobResultRequest {
	ID string `path:"id"` // 任务ID
}

type JobResultResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type JobListRequest {
	Status     string `form:"status,optional"`
	FunctionID string `form:"function_id,optional"`
	Actor      string `form:"actor,optional"`
	GameID     string `form:"game_id,optional"`
	Env        string `form:"env,optional"`
	Page       int    `form:"page,optional,default=1"`
	Size       int    `form:"size,optional,default=20"`
}

type JobListResponse {
	Jobs  []JobItem `json:"jobs"`
	Total int       `json:"total"`
}

type JobItem {
	ID         string `json:"id"`
	FunctionID string `json:"function_id,omitempty"`
	Actor      string `json:"actor,omitempty"`
	State      string `json:"state,omitempty"`
	GameID     string `json:"game_id,omitempty"`
	Env        string `json:"env,omitempty"`
	RPCAddr    string `json:"rpc_addr,omitempty"`
	StartedAt  string `json:"started_at,omitempty"`
	EndedAt    string `json:"ended_at,omitempty"`
	DurationMs int64  `json:"duration_ms,omitempty"`
	Error      string `json:"error,omitempty"`
}

type JobStartRequest {
	FunctionID string      `json:"functionId"` // 函数ID
	Params     interface{} `json:"params,optional"`
}

type JobStartResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 任务流 ---
type StreamJobRequest {
	JobID string `path:"jobId"`
}

type StreamJobResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/jobs
	group:  job
)
service server {
	@doc "任务列表"
	@handler JobListHandler
	get / (JobListRequest) returns (JobListResponse)

	@doc "启动任务"
	@handler JobStartHandler
	post / (JobStartRequest) returns (JobStartResponse)

	@doc "取消任务"
	@handler JobCancelHandler
	post /:id/cancel (JobCancelRequest) returns (JobCancelResponse)

	@doc "获取任务结果"
	@handler JobResultHandler
	get /:id/result (JobResultRequest) returns (JobResultResponse)

	@doc "任务流（实时状态和日志）"
	@handler StreamJobHandler
	get /:jobId/stream (StreamJobRequest) returns (StreamJobResponse)
}
