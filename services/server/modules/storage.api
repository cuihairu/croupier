// ============================================================================
// STORAGE 模块 API 定义 - 文件存储和访问
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- 签名 URL ---
type SignedUrlRequest {
	Path   string `form:"path"`
	Expire int    `form:"expire,optional"`
}

type SignedUrlResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 列出对象 ---
type ListObjectsRequest {
	Prefix    string `form:"prefix,optional"`
	Marker    string `form:"marker,optional"`
	Limit     int    `form:"limit,optional"`
	Delimiter string `form:"delimiter,optional"`
}

type ObjectInfo {
	Key          string `json:"key"`
	Size         int64  `json:"size"`
	LastModified string `json:"last_modified"`
	ETag         string `json:"etag"`
	StorageClass string `json:"storage_class,optional"`
}

type ObjectsData {
	Objects     []ObjectInfo `json:"objects"`
	Prefixes    []string     `json:"prefixes,optional"`
	IsTruncated bool         `json:"is_truncated"`
	NextMarker  string       `json:"next_marker,optional"`
}

type ListObjectsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    ObjectsData `json:"data"`
}

// --- 上传对象 ---
type UploadObjectRequest {
	// 使用 multipart/form-data，字段名为 file
}

type UploadObjectData {
	Key string `json:"key"`
	URL string `json:"url"`
}

type UploadObjectResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    UploadObjectData `json:"data"`
}

// --- 删除对象 ---
type DeleteObjectRequest {
	Key string `form:"key"`
}

type DeleteObjectResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

// --- 批量删除对象 ---
type BatchDeleteObjectsRequest {
	Keys []string `json:"keys"`
}

type BatchDeleteObjectsData {
	Deleted []string `json:"deleted"`
	Failed  []string `json:"failed,optional"`
}

type BatchDeleteObjectsResponse {
	Code    int                    `json:"code"`
	Message string                 `json:"message"`
	Data    BatchDeleteObjectsData `json:"data"`
}

// --- 创建目录 ---
type CreateDirectoryRequest {
	Prefix string `json:"prefix"`
}

type CreateDirectoryResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

// --- 重命名/移动目录 ---
type RenameDirectoryRequest {
	OldPrefix string `json:"old_prefix"`
	NewPrefix string `json:"new_prefix"`
}

type RenameDirectoryResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/storage
	group:  storage
)
service server {
	@doc "获取签名URL"
	@handler SignedUrlHandler
	get /signed-url (SignedUrlRequest) returns (SignedUrlResponse)

	@doc "列出对象"
	@handler ListObjectsHandler
	get /objects (ListObjectsRequest) returns (ListObjectsResponse)

	@doc "上传对象"
	@handler UploadObjectHandler
	post /objects (UploadObjectRequest) returns (UploadObjectResponse)

	@doc "删除对象"
	@handler DeleteObjectHandler
	delete /objects (DeleteObjectRequest) returns (DeleteObjectResponse)

	@doc "批量删除对象"
	@handler BatchDeleteObjectsHandler
	post /objects/batch-delete (BatchDeleteObjectsRequest) returns (BatchDeleteObjectsResponse)

	@doc "创建目录"
	@handler CreateDirectoryHandler
	post /directories (CreateDirectoryRequest) returns (CreateDirectoryResponse)

	@doc "重命名/移动目录"
	@handler RenameDirectoryHandler
	post /directories/rename (RenameDirectoryRequest) returns (RenameDirectoryResponse)
}
