// ============================================================================
// ENTITY 模块 API 定义 - 实体管理
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- Entity 列表 ---
type EntitiesListRequest {
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
	Type     string `form:"type,optional"`
}

type EntitiesListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 创建 ---
type EntityCreateRequest {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

type EntityCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 详情 ---
type EntityDetailRequest {
	ID string `path:"id"`
}

type EntityDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 更新 ---
type EntityUpdateRequest {
	ID   string      `path:"id"`
	Data interface{} `json:"data"`
}

type EntityUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 删除 ---
type EntityDeleteRequest {
	ID string `path:"id"`
}

type EntityDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 预览 ---
type EntityPreviewRequest {
	ID string `path:"id"`
}

type EntityPreviewResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Entity 验证 ---
type EntityValidateRequest {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

type EntityValidateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/entities
	group:  entity
)
service server {
	@doc "获取实体列表"
	@handler EntitiesListHandler
	get / (EntitiesListRequest) returns (EntitiesListResponse)

	@doc "创建实体"
	@handler EntityCreateHandler
	post / (EntityCreateRequest) returns (EntityCreateResponse)

	@doc "获取实体详情"
	@handler EntityDetailHandler
	get /:id (EntityDetailRequest) returns (EntityDetailResponse)

	@doc "更新实体"
	@handler EntityUpdateHandler
	put /:id (EntityUpdateRequest) returns (EntityUpdateResponse)

	@doc "删除实体"
	@handler EntityDeleteHandler
	delete /:id (EntityDeleteRequest) returns (EntityDeleteResponse)

	@doc "预览实体"
	@handler EntityPreviewHandler
	get /:id/preview (EntityPreviewRequest) returns (EntityPreviewResponse)

	@doc "验证实体"
	@handler EntityValidateHandler
	post /validate (EntityValidateRequest) returns (EntityValidateResponse)
}
