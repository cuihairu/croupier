// ============================================================================
// OPS 模块 API 定义
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// 健康检查项
type OpsHealthCheck {
	ID          string `json:"id"`
	Name        string `json:"name,optional"`
	Enabled     bool   `json:"enabled"`
	Type        string `json:"type,optional"`
	Kind        string `json:"kind,optional"`
	Target      string `json:"target,optional"`
	Expect      string `json:"expect,optional"`
	Region      string `json:"region,optional"`
	Interval    int    `json:"interval,optional"`
	IntervalSec int    `json:"intervalSec,optional"`
	TimeoutMs   int    `json:"timeoutMs,optional"`
}

// 通知渠道
type OpsNotificationChannel {
	ID     string `json:"id"`
	Type   string `json:"type"`
	URL    string `json:"url"`
	Secret string `json:"secret,optional"`
}

// 通知规则
type OpsNotificationRule {
	Event         string   `json:"event"`
	Channels      []string `json:"channels"`
	ThresholdDays int      `json:"thresholdDays,optional"`
}

// 维护窗口
type OpsMaintenanceWindow {
	ID          string `json:"id,optional"`
	GameID      string `json:"gameId,optional"`
	Env         string `json:"env,optional"`
	Start       string `json:"start"`
	End         string `json:"end"`
	Message     string `json:"message,optional"`
	BlockWrites bool   `json:"blockWrites,optional"`
}

type OpsAgentMetaUpdateRequest {
	AgentID string      `json:"agentId"`
	Meta    interface{} `json:"meta"`
}

type OpsAgentMetaResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsAlertSilenceRequest {
	AlertID  string `json:"alertId"`
	Duration int    `json:"duration"` // 静默时长（分钟）
}

type OpsAlertSilenceResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsAlertsRequest {}

type OpsAlert {
	Severity    string                 `json:"severity,omitempty"`
	Service     string                 `json:"service,omitempty"`
	Instance    string                 `json:"instance,omitempty"`
	Summary     string                 `json:"summary,omitempty"`
	StartsAt    string                 `json:"starts_at,omitempty"`
	EndsAt      string                 `json:"ends_at,omitempty"`
	Duration    string                 `json:"duration,omitempty"`
	Silenced    bool                   `json:"silenced,omitempty"`
	Labels      map[string]interface{} `json:"labels,omitempty"`
	Annotations map[string]interface{} `json:"annotations,omitempty"`
}

type OpsAlertsResponse {
	Alerts []OpsAlert `json:"alerts"`
}

type OpsBackupCreateRequest {
	Name string `json:"name,optional"`
}

type OpsBackupCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsBackupDeleteRequest {
	ID string `path:"id"`
}

type OpsBackupDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsBackupDownloadRequest {
	ID string `path:"id"`
}

type OpsBackupDownloadResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsBackupsListRequest {
	Page     int `form:"page,optional"`
	PageSize int `form:"pageSize,optional"`
}

type OpsBackupsListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsConfigRequest {}

type OpsConfigResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsFunctionsRequest {}

type OpsFunctionsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsHealthGetRequest {}

type OpsHealthGetResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsHealthRunRequest {
	ID string `json:"id,optional"`
}

type OpsHealthRunResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsHealthUpdateRequest {
	Enabled bool             `json:"enabled"`
	Checks  []OpsHealthCheck `json:"checks,optional"`
}

type OpsHealthUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsMaintenanceGetRequest {}

type OpsMaintenanceGetResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsMaintenanceUpdateRequest {
	Enabled bool                   `json:"enabled"`
	Message string                 `json:"message,optional"`
	Windows []OpsMaintenanceWindow `json:"windows,optional"`
}

type OpsMaintenanceUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsMetricsQuery {
	Start string `form:"start,optional"`
	End   string `form:"end,optional"`
}

type OpsMetricsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsMQRequest {}

type OpsMQResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodeCommandsQuery {
	NodeID string `form:"nodeId"`
}

type OpsNodeCommandsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodeActionRequest {
	NodeID string `path:"nodeId"`
}

type OpsNodeDrainResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodeMetaRequest {
	NodeID string `path:"nodeId"`
}

type OpsNodeMetaResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodeRestartResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodesRequest {}

type OpsNodesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNodeUndrainResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNotificationsGetRequest {}

type OpsNotificationsGetResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsNotificationsUpdateRequest {
	Enabled  bool                     `json:"enabled"`
	Channels []OpsNotificationChannel `json:"channels,optional"`
	Rules    []OpsNotificationRule    `json:"rules,optional"`
}

type OpsNotificationsUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsServicesRequest {}

type OpsServiceItem {
	ID             string            `json:"id"`
	Name           string            `json:"name"`
	Type           string            `json:"type"`
	Status         string            `json:"status"`
	Address        string            `json:"address,optional"`
	GameID         string            `json:"gameId,optional"`
	Env            string            `json:"env,optional"`
	Version        string            `json:"version,optional"`
	Region         string            `json:"region,optional"`
	Zone           string            `json:"zone,optional"`
	Labels         map[string]string `json:"labels,optional"`
	FunctionsCount int               `json:"functionsCount,optional"`
	LastSeen       string            `json:"lastSeen,optional"`
}

type OpsServicesResponse {
	Services []OpsServiceItem `json:"services"`
	Total    int              `json:"total"`
}

type OpsAlertSilenceDeleteRequest {
	ID string `path:"id"`
}

type OpsSilenceDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type OpsSilencesRequest {}

type OpsSilencesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// Agent Ops 相关类型定义
// ============================================================================
type OpsAgentsListRequest {}

type OpsAgentInfo {
	AgentID   string            `json:"agentId"`
	GameID    string            `json:"gameId"`
	Env       string            `json:"env"`
	Version   string            `json:"version"`
	RPCAddr   string            `json:"rpcAddr"`
	Connected bool              `json:"connected"`
	LastSeen  string            `json:"lastSeen"`
	Functions []string          `json:"functions"`
	Processes []string          `json:"processes"`
	Labels    map[string]string `json:"labels"`
}

type OpsAgentsListResponse {
	Code    int            `json:"code"`
	Message string         `json:"message"`
	Data    []OpsAgentInfo `json:"data,omitempty"`
}

type OpsAgentMetricsRequest {
	AgentID string `form:"agentId,optional"`
	Since   string `form:"since,optional"`
	Limit   int    `form:"limit,optional"`
}

type OpsCpuMetrics {
	UsagePercent float64   `json:"usagePercent"`
	Cores        int32     `json:"cores"`
	PerCore      []float64 `json:"perCore,omitempty"`
	Load1M       float64   `json:"load1m"`
	Load5M       float64   `json:"load5m"`
	Load15M      float64   `json:"load15m"`
}

type OpsMemoryMetrics {
	TotalBytes     uint64  `json:"totalBytes"`
	UsedBytes      uint64  `json:"usedBytes"`
	AvailableBytes uint64  `json:"availableBytes"`
	UsagePercent   float64 `json:"usagePercent"`
	SwapTotal      uint64  `json:"swapTotal"`
	SwapUsed       uint64  `json:"swapUsed"`
}

type OpsDiskMetrics {
	MountPoint     string  `json:"mountPoint"`
	Device         string  `json:"device"`
	FsType         string  `json:"fsType"`
	TotalBytes     uint64  `json:"totalBytes"`
	UsedBytes      uint64  `json:"usedBytes"`
	AvailableBytes uint64  `json:"availableBytes"`
	UsagePercent   float64 `json:"usagePercent"`
}

type OpsNetworkMetrics {
	Interface   string `json:"interface"`
	BytesSent   uint64 `json:"bytesSent"`
	BytesRecv   uint64 `json:"bytesRecv"`
	PacketsSent uint64 `json:"packetsSent"`
	PacketsRecv uint64 `json:"packetsRecv"`
}

type OpsMetricsData {
	AgentID   string              `json:"agentId"`
	Timestamp string              `json:"timestamp"`
	CPU       OpsCpuMetrics       `json:"cpu"`
	Memory    OpsMemoryMetrics    `json:"memory"`
	Disks     []OpsDiskMetrics    `json:"disks,omitempty"`
	Networks  []OpsNetworkMetrics `json:"networks,omitempty"`
}

type OpsAgentMetricsResponse {
	Code    int              `json:"code"`
	Message string           `json:"message"`
	Data    []OpsMetricsData `json:"data,omitempty"`
}

type OpsAgentSystemInfoRequest {
	AgentID string `path:"agentId"`
}

type OpsAgentSystemInfo {
	Hostname      string `json:"hostname"`
	OS            string `json:"os"`
	OSVersion     string `json:"osVersion"`
	KernelVersion string `json:"kernelVersion"`
	Arch          string `json:"arch"`
	CPUCores      int32  `json:"cpuCores"`
	TotalMemory   uint64 `json:"totalMemory"`
	BootTime      string `json:"bootTime"`
	AgentVersion  string `json:"agentVersion"`
}

type OpsAgentSystemInfoResponse {
	Code    int                `json:"code"`
	Message string             `json:"message"`
	Data    OpsAgentSystemInfo `json:"data,omitempty"`
}

type OpsAgentProcessesRequest {
	AgentID string `path:"agentId"`
}

type OpsManagedProcess {
	Name         string `json:"name"`
	Command      string `json:"command"`
	WorkingDir   string `json:"workingDir"`
	State        string `json:"state"`
	Pid          int32  `json:"pid"`
	RestartCount int32  `json:"restartCount"`
	LastStart    string `json:"lastStart,omitempty"`
}

type OpsAgentProcessesResponse {
	Code    int                 `json:"code"`
	Message string              `json:"message"`
	Data    []OpsManagedProcess `json:"data,omitempty"`
}

type OpsProcessActionRequest {
	AgentID string `path:"agentId"`
	Name    string `path:"name"`
	Force   bool   `json:"force,optional"`
}

type OpsProcessActionResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    int32  `json:"pid,omitempty"`
}

type OpsProcessStartRequest {
	AgentID string `path:"agentId"`
	Name    string `path:"name"`
}

type OpsProcessStartResponse {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    int32  `json:"pid,omitempty"`
}

type OpsExecCommandRequest {
	AgentID string   `path:"agentId"`
	Command string   `json:"command"`
	Args    []string `json:"args,optional"`
	Timeout int32    `json:"timeout,optional"`
}

type OpsExecCommandResult {
	Success  bool   `json:"success"`
	ExitCode int32  `json:"exitCode"`
	Stdout   string `json:"stdout"`
	Stderr   string `json:"stderr"`
}

type OpsExecCommandResponse {
	Code    int                  `json:"code"`
	Message string               `json:"message"`
	Data    OpsExecCommandResult `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/ops
	group:  ops
)
service server {
	@doc "更新代理元数据"
	@handler OpsAgentMetaHandler
	put /agent-meta (OpsAgentMetaUpdateRequest) returns (OpsAgentMetaResponse)

	@doc "获取告警列表"
	@handler OpsAlertsHandler
	get /alerts (OpsAlertsRequest) returns (OpsAlertsResponse)

	@doc "静默告警"
	@handler OpsAlertSilenceHandler
	post /alerts/silence (OpsAlertSilenceRequest) returns (OpsAlertSilenceResponse)

	@doc "创建备份"
	@handler OpsBackupCreateHandler
	post /backups (OpsBackupCreateRequest) returns (OpsBackupCreateResponse)

	@doc "删除备份"
	@handler OpsBackupDeleteHandler
	delete /backups/:id (OpsBackupDeleteRequest) returns (OpsBackupDeleteResponse)

	@doc "下载备份"
	@handler OpsBackupDownloadHandler
	get /backups/:id/download (OpsBackupDownloadRequest) returns (OpsBackupDownloadResponse)

	@doc "获取备份列表"
	@handler OpsBackupsListHandler
	get /backups (OpsBackupsListRequest) returns (OpsBackupsListResponse)

	@doc "获取运维配置"
	@handler OpsConfigHandler
	get /config (OpsConfigRequest) returns (OpsConfigResponse)

	@doc "获取函数列表"
	@handler OpsFunctionsHandler
	get /functions (OpsFunctionsRequest) returns (OpsFunctionsResponse)

	@doc "获取健康状态"
	@handler OpsHealthGetHandler
	get /health (OpsHealthGetRequest) returns (OpsHealthGetResponse)

	@doc "运行健康检查"
	@handler OpsHealthRunHandler
	post /health/run (OpsHealthRunRequest) returns (OpsHealthRunResponse)

	@doc "更新健康检查配置"
	@handler OpsHealthUpdateHandler
	put /health (OpsHealthUpdateRequest) returns (OpsHealthUpdateResponse)

	@doc "获取维护模式状态"
	@handler OpsMaintenanceGetHandler
	get /maintenance (OpsMaintenanceGetRequest) returns (OpsMaintenanceGetResponse)

	@doc "更新维护模式"
	@handler OpsMaintenanceUpdateHandler
	put /maintenance (OpsMaintenanceUpdateRequest) returns (OpsMaintenanceUpdateResponse)

	@doc "获取指标"
	@handler OpsMetricsHandler
	get /metrics (OpsMetricsQuery) returns (OpsMetricsResponse)

	@doc "获取消息队列状态"
	@handler OpsMQHandler
	get /mq (OpsMQRequest) returns (OpsMQResponse)

	@doc "获取节点命令"
	@handler OpsNodeCommandsHandler
	get /nodes/commands (OpsNodeCommandsQuery) returns (OpsNodeCommandsResponse)

	@doc "排空节点"
	@handler OpsNodeDrainHandler
	post /nodes/:nodeId/drain (OpsNodeActionRequest) returns (OpsNodeDrainResponse)

	@doc "获取节点元数据"
	@handler OpsNodeMetaHandler
	get /nodes/:nodeId/meta (OpsNodeMetaRequest) returns (OpsNodeMetaResponse)

	@doc "重启节点"
	@handler OpsNodeRestartHandler
	post /nodes/:nodeId/restart (OpsNodeActionRequest) returns (OpsNodeRestartResponse)

	@doc "获取节点列表"
	@handler OpsNodesHandler
	get /nodes (OpsNodesRequest) returns (OpsNodesResponse)

	@doc "取消排空节点"
	@handler OpsNodeUndrainHandler
	post /nodes/:nodeId/undrain (OpsNodeActionRequest) returns (OpsNodeUndrainResponse)

	@doc "获取通知配置"
	@handler OpsNotificationsGetHandler
	get /notifications (OpsNotificationsGetRequest) returns (OpsNotificationsGetResponse)

	@doc "更新通知配置"
	@handler OpsNotificationsUpdateHandler
	put /notifications (OpsNotificationsUpdateRequest) returns (OpsNotificationsUpdateResponse)

	@doc "获取服务列表"
	@handler OpsServicesHandler
	get /services (OpsServicesRequest) returns (OpsServicesResponse)

	@doc "删除静默规则"
	@handler OpsSilenceDeleteHandler
	delete /silences/:id (OpsAlertSilenceDeleteRequest) returns (OpsSilenceDeleteResponse)

	@doc "获取静默规则列表"
	@handler OpsSilencesHandler
	get /silences (OpsSilencesRequest) returns (OpsSilencesResponse)

	// ============================================================================
	// Agent Ops 相关路由
	// ============================================================================
	@doc "获取 Agent 列表"
	@handler OpsAgentsListHandler
	get /agents (OpsAgentsListRequest) returns (OpsAgentsListResponse)

	@doc "获取 Agent 指标"
	@handler OpsAgentMetricsHandler
	get /agents/metrics (OpsAgentMetricsRequest) returns (OpsAgentMetricsResponse)

	@doc "获取 Agent 系统信息"
	@handler OpsAgentSystemInfoHandler
	get /agents/:agentId/system-info (OpsAgentSystemInfoRequest) returns (OpsAgentSystemInfoResponse)

	@doc "获取 Agent 进程列表"
	@handler OpsAgentProcessesHandler
	get /agents/:agentId/processes (OpsAgentProcessesRequest) returns (OpsAgentProcessesResponse)

	@doc "重启 Agent 进程"
	@handler OpsAgentProcessRestartHandler
	post /agents/:agentId/processes/:name/restart (OpsProcessActionRequest) returns (OpsProcessActionResponse)

	@doc "停止 Agent 进程"
	@handler OpsAgentProcessStopHandler
	post /agents/:agentId/processes/:name/stop (OpsProcessActionRequest) returns (OpsProcessActionResponse)

	@doc "启动 Agent 进程"
	@handler OpsAgentProcessStartHandler
	post /agents/:agentId/processes/:name/start (OpsProcessStartRequest) returns (OpsProcessStartResponse)

	@doc "在 Agent 上执行命令（高风险）"
	@handler OpsAgentExecCommandHandler
	post /agents/:agentId/exec (OpsExecCommandRequest) returns (OpsExecCommandResponse)
}

