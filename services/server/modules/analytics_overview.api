// ============================================================================
// ANALYTICS OVERVIEW 模块 API 定义 - 概览和实时数据
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
type AnalyticsQuery {
	GameId    string `form:"gameId,optional"`
	Env       string `form:"env,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

// --- 概览 ---
type OverviewRequest {
	AnalyticsQuery
}

type OverviewMetrics {
	DAU        int     `json:"dau"`
	MAU        int     `json:"mau"`
	NewUsers   int     `json:"newUsers"`
	Revenue    float64 `json:"revenue"`
	ARPU       float64 `json:"arpu"`
	ARPPU      float64 `json:"arppu"`
	PayingRate float64 `json:"payingRate"`
}

type OverviewResponse {
	Metrics OverviewMetrics `json:"metrics"`
	Trends  interface{}     `json:"trends"`
}

// --- 实时数据 ---
type RealtimeRequest {
	GameId string `form:"gameId,optional"`
	Env    string `form:"env,optional"`
}

type RealtimeMetrics {
	OnlineUsers    int         `json:"onlineUsers"`
	ActiveSessions int         `json:"activeSessions"`
	QPS            float64     `json:"qps"`
	AvgLatency     float64     `json:"avgLatency"`
	ErrorRate      float64     `json:"errorRate"`
	TopEvents      interface{} `json:"topEvents"`
}

type RealtimeResponse {
	RealtimeMetrics
	Timestamp string `json:"timestamp"`
}

// --- 实时序列数据 ---
type RealtimeSeriesRequest {
	GameId   string `form:"gameId,optional"`
	Env      string `form:"env,optional"`
	Interval string `form:"interval,optional,default=1m"` // 1m, 5m, 15m
	Duration int    `form:"duration,optional,default=60"` // 分钟
}

type RealtimeSeriesResponse {
	Series interface{} `json:"series"`
}

// --- 数据采集 ---
type IngestRequest {
	GameId    string      `json:"gameId"`
	Env       string      `json:"env"`
	Events    interface{} `json:"events"`
	Timestamp string      `json:"timestamp,optional"`
}

type IngestResponse {
	Accepted int    `json:"accepted"`
	Rejected int    `json:"rejected"`
	BatchId  string `json:"batchId"`
}

// --- 过滤器 ---
type FiltersGetRequest {
	GameId string `form:"gameId,optional"`
}

type AnalyticsFilters {
	GameId  string      `json:"gameId"`
	Filters interface{} `json:"filters"`
}

type FiltersGetResponse {
	Items []AnalyticsFilters `json:"items"`
}

type FiltersUpdateRequest {
	GameId  string      `json:"gameId"`
	Filters interface{} `json:"filters"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/analytics
	group:  analytics_overview
)
service server {
	@doc "获取分析概览"
	@handler OverviewHandler
	get /overview (OverviewRequest) returns (OverviewResponse)

	@doc "获取实时数据"
	@handler RealtimeHandler
	get /realtime (RealtimeRequest) returns (RealtimeResponse)

	@doc "获取实时序列数据"
	@handler RealtimeSeriesHandler
	get /realtime/series (RealtimeSeriesRequest) returns (RealtimeSeriesResponse)

	@doc "采集分析数据"
	@handler IngestHandler
	post /ingest (IngestRequest) returns (IngestResponse)

	@doc "获取分析过滤器"
	@handler FiltersGetHandler
	get /filters (FiltersGetRequest) returns (FiltersGetResponse)

	@doc "更新分析过滤器"
	@handler FiltersUpdateHandler
	put /filters (FiltersUpdateRequest) returns (FiltersGetResponse)
}

