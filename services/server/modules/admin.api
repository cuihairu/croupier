// ============================================================================
// ADMIN 模块 API 定义 - 管理员管理
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- 管理员定义 ---
type Admin {
	Id        int64    `json:"id"`
	Username  string   `json:"username"`
	Nickname  string   `json:"nickname"`
	Email     string   `json:"email"`
	Phone     string   `json:"phone"`
	Roles     []string `json:"roles"`
	Status    int      `json:"status"` // 1:active 0:disabled
	CreatedAt string   `json:"createdAt"`
	UpdatedAt string   `json:"updatedAt"`
}

// --- 角色定义 ---
type Role {
	Id          int64    `json:"id"`
	Name        string   `json:"name"`
	Description string   `json:"description"`
	Category    string   `json:"category"`
	Permissions []string `json:"permissions"`
	CreatedAt   string   `json:"createdAt"`
	UpdatedAt   string   `json:"updatedAt"`
}

// --- 权限定义 ---
type Permission {
	Id          string `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Resource    string `json:"resource"`
	Action      string `json:"action"`
	Category    string `json:"category"`
	CreatedAt   string `json:"createdAt"`
	UpdatedAt   string `json:"updatedAt"`
}

// ============================================================================
// 管理员管理 API
// ============================================================================
// --- 管理员列表 ---
type AdminsListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Search   string `form:"search,optional"`
	Role     string `form:"role,optional"`
	Status   int    `form:"status,optional"`
}

type AdminsListResponse {
	Items []Admin `json:"items"`
	Total int64   `json:"total"`
	Page  int     `json:"page"`
	Size  int     `json:"pageSize"`
}

// --- 管理员创建 ---
type AdminCreateRequest {
	Username string   `json:"username"`
	Password string   `json:"password"`
	Nickname string   `json:"nickname,optional"`
	Email    string   `json:"email,optional"`
	Phone    string   `json:"phone,optional"`
	Roles    []string `json:"roles"`
}

type AdminCreateResponse {
	Admin
}

// --- 管理员详情 ---
type AdminDetailRequest {
	ID string `path:"id"`
}

type AdminDetailResponse {
	Admin
}

// --- 管理员更新 ---
type AdminUpdateRequest {
	ID       string   `path:"id"`
	Nickname string   `json:"nickname,optional"`
	Email    string   `json:"email,optional"`
	Phone    string   `json:"phone,optional"`
	Roles    []string `json:"roles,optional"`
	Status   int      `json:"status,optional"`
}

type AdminUpdateResponse {
	Admin
}

// --- 管理员删除 ---
type AdminDeleteRequest {
	ID string `path:"id"`
}

type AdminDeleteResponse {
	Message string `json:"message"`
}

// --- 重置密码 ---
type AdminPasswordResetRequest {
	ID          string `path:"id"`
	NewPassword string `json:"newPassword"`
}

type AdminPasswordResetResponse {
	Message string `json:"message"`
}

// ============================================================================
// 角色管理 API
// ============================================================================
// --- 角色列表 ---
type RolesListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Category string `form:"category,optional"`
	Search   string `form:"search,optional"`
}

type RolesListResponse {
	Items []Role `json:"items"`
	Total int64  `json:"total"`
	Page  int    `json:"page"`
	Size  int    `json:"pageSize"`
}

// --- 角色创建 ---
type RoleCreateRequest {
	Name        string   `json:"name"`
	Description string   `json:"description,optional"`
	Category    string   `json:"category,optional"`
	Permissions []string `json:"permissions,optional"`
}

type RoleCreateResponse {
	Role
}

// --- 角色详情 ---
type RoleDetailRequest {
	ID string `path:"id"`
}

type RoleDetailResponse {
	Role
}

// --- 角色更新 ---
type RoleUpdateRequest {
	ID          string   `path:"id"`
	Name        string   `json:"name,optional"`
	Description string   `json:"description,optional"`
	Category    string   `json:"category,optional"`
	Permissions []string `json:"permissions,optional"`
}

type RoleUpdateResponse {
	Role
}

// --- 角色删除 ---
type RoleDeleteRequest {
	ID string `path:"id"`
}

// ============================================================================
// 权限管理 API
// ============================================================================
// --- 权限列表 ---
type PermissionsListRequest {
	Page     int    `form:"page,optional,default=1"`
	PageSize int    `form:"pageSize,optional,default=20"`
	Category string `form:"category,optional"`
	Resource string `form:"resource,optional"`
}

type PermissionsListResponse {
	Items []Permission `json:"items"`
	Total int64        `json:"total"`
	Page  int          `json:"page"`
	Size  int          `json:"pageSize"`
}

// --- 权限详情 ---
type PermissionDetailRequest {
	ID string `path:"id"`
}

type PermissionDetailResponse {
	Permission
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/admin
	group:  admin
)
service server {
	// === 管理员管理 ===
	@doc "获取管理员列表"
	@handler AdminsListHandler
	get / (AdminsListRequest) returns (AdminsListResponse)

	@doc "创建管理员"
	@handler AdminCreateHandler
	post / (AdminCreateRequest) returns (AdminCreateResponse)

	@doc "获取管理员详情"
	@handler AdminDetailHandler
	get /:id (AdminDetailRequest) returns (AdminDetailResponse)

	@doc "更新管理员"
	@handler AdminUpdateHandler
	put /:id (AdminUpdateRequest) returns (AdminUpdateResponse)

	@doc "删除管理员"
	@handler AdminDeleteHandler
	delete /:id (AdminDeleteRequest)

	@doc "重置管理员密码"
	@handler AdminPasswordResetHandler
	post /:id/password-reset (AdminPasswordResetRequest)
}

@server (
	prefix: /api/v1/roles
	group:  role
)
service server {
	// === 角色管理 ===
	@doc "获取角色列表"
	@handler RolesListHandler
	get / (RolesListRequest) returns (RolesListResponse)

	@doc "创建角色"
	@handler RoleCreateHandler
	post / (RoleCreateRequest) returns (RoleCreateResponse)

	@doc "获取角色详情"
	@handler RoleDetailHandler
	get /:id (RoleDetailRequest) returns (RoleDetailResponse)

	@doc "更新角色"
	@handler RoleUpdateHandler
	put /:id (RoleUpdateRequest) returns (RoleUpdateResponse)

	@doc "删除角色"
	@handler RoleDeleteHandler
	delete /:id (RoleDeleteRequest)
}

@server (
	prefix: /api/v1/permissions
	group:  permission
)
service server {
	// === 权限管理 ===
	@doc "获取权限列表"
	@handler PermissionsListHandler
	get / (PermissionsListRequest) returns (PermissionsListResponse)

	@doc "获取权限详情"
	@handler PermissionDetailHandler
	get /:id (PermissionDetailRequest) returns (PermissionDetailResponse)
}

