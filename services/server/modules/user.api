// ============================================================================
// USER 模块 API 定义
// ============================================================================
// ============================================================================
// 类型定义
// ============================================================================
// --- 用户列表 ---
type UsersListRequest {
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
	Search   string `form:"search,optional"`
	Role     string `form:"role,optional"`
}

type UsersListResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户创建 ---
type UserCreateRequest {
	Username string   `json:"username"`
	Password string   `json:"password"`
	Email    string   `json:"email,optional"`
	Roles    []string `json:"roles,optional"`
}

type UserCreateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户详情 ---
type UserDetailRequest {
	ID string `path:"id"`
}

type UserDetailResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户更新 ---
type UserUpdateRequest {
	ID       string   `path:"id"`
	Username string   `json:"username,optional"`
	Email    string   `json:"email,optional"`
	Roles    []string `json:"roles,optional"`
	Status   string   `json:"status,optional"`
}

type UserUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户删除 ---
type UserDeleteRequest {
	ID string `path:"id"`
}

type UserDeleteResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 当前用户 ---
type UserCurrentRequest {}

type UserCurrentResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户资料 ---
type UserProfileRequest {
	ID string `path:"id"`
}

type UserProfileResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户游戏环境 ---
type UserGameEnvsRequest {
	ID string `path:"id"`
}

type UserGameEnvsResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type UserGameEnvsUpdateRequest {
	ID       string   `path:"id"`
	GameEnvs []string `json:"gameEnvs"`
}

type UserGameEnvsUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 用户游戏 ---
type UserGamesRequest {
	ID string `path:"id"`
}

type UserGamesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type UserGamesUpdateRequest {
	ID    string   `path:"id"`
	Games []string `json:"games"`
}

type UserGamesUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- 密码重置 ---
type UserPasswordResetRequest {
	ID string `path:"id"`
}

type UserPasswordResetResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// --- Me 相关 ---
type MeProfileRequest {}

type MeProfileResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type MeProfileUpdateRequest {
	Name   string `json:"name,optional"`
	Avatar string `json:"avatar,optional"`
	Email  string `json:"email,optional"`
}

type MeProfileUpdateResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type MeGamesRequest {}

type MeGamesResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

type MePasswordRequest {
	OldPassword string `json:"oldPassword"`
	NewPassword string `json:"newPassword"`
}

type MePasswordResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data,omitempty"`
}

// ============================================================================
// 服务定义
// ============================================================================
@server (
	prefix: /api/v1/users
	group:  user
)
service server {
	@doc "获取用户列表"
	@handler UsersListHandler
	get / (UsersListRequest) returns (UsersListResponse)

	@doc "创建用户"
	@handler UserCreateHandler
	post / (UserCreateRequest) returns (UserCreateResponse)

	@doc "获取当前用户"
	@handler UserCurrentHandler
	get /current (UserCurrentRequest) returns (UserCurrentResponse)

	@doc "获取用户详情"
	@handler UserDetailHandler
	get /:id (UserDetailRequest) returns (UserDetailResponse)

	@doc "更新用户"
	@handler UserUpdateHandler
	put /:id (UserUpdateRequest) returns (UserUpdateResponse)

	@doc "删除用户"
	@handler UserDeleteHandler
	delete /:id (UserDeleteRequest) returns (UserDeleteResponse)

	@doc "获取用户资料"
	@handler UserProfileHandler
	get /:id/profile (UserProfileRequest) returns (UserProfileResponse)

	@doc "获取用户游戏环境"
	@handler UserGameEnvsHandler
	get /:id/game-envs (UserGameEnvsRequest) returns (UserGameEnvsResponse)

	@doc "更新用户游戏环境"
	@handler UserGameEnvsUpdateHandler
	put /:id/game-envs (UserGameEnvsUpdateRequest) returns (UserGameEnvsUpdateResponse)

	@doc "获取用户游戏"
	@handler UserGamesHandler
	get /:id/games (UserGamesRequest) returns (UserGamesResponse)

	@doc "更新用户游戏"
	@handler UserGamesUpdateHandler
	put /:id/games (UserGamesUpdateRequest) returns (UserGamesUpdateResponse)

	@doc "重置用户密码"
	@handler UserPasswordResetHandler
	post /:id/password-reset (UserPasswordResetRequest) returns (UserPasswordResetResponse)
}

// Me 服务 - 当前登录用户相关操作
@server (
	prefix: /api/v1/me
	group:  me
)
service server {
	@doc "获取我的资料"
	@handler MeProfileHandler
	get /profile (MeProfileRequest) returns (MeProfileResponse)

	@doc "更新我的资料"
	@handler MeProfileUpdateHandler
	put /profile (MeProfileUpdateRequest) returns (MeProfileUpdateResponse)

	@doc "获取我的游戏"
	@handler MeGamesHandler
	get /games (MeGamesRequest) returns (MeGamesResponse)

	@doc "修改我的密码"
	@handler MePasswordHandler
	put /password (MePasswordRequest) returns (MePasswordResponse)
}

